    {
      "parameters": {
        "jsCode": "return $input.all().filter((i) => i.json.id).map((i) => {\n  const due = new Date(new Date(i.json.status_changed_at).getTime() + 48 * 3600e3);\n  const h = due.toLocaleString('fr-FR', { timeZone: 'Asia/Bangkok', weekday: 'long', hour: '2-digit', minute: '2-digit' });\n  return { json: { id: i.json.id, telegram: `⏰ Rapport à envoyer : ${i.json.client_name} est en « Vérification » depuis plus de 36 h. Échéance des 48 h : ${h} (heure de Bangkok).` } };\n});\n"
      },
