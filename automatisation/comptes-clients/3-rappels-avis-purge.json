      "id": "b0d44b37-4fdd-4cf5-aa79-b159613a3b60",
      "name": "Supabase : visas obtenus sans avis demandé",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        320
      ],
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase MyVisaDTV (service_role)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const SITE = 'https://myvisadtv.com';\nconst espaceUrl = (lang) => SITE + ({ en: '/en', de: '/de' }[lang] || '') + '/dossier/';\nconst esc = (s) => String(s ?? '').replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' })[c]);\nconst first = (n) => esc(String(n || '').trim().split(/\\s+/)[0] || '');\nconst SIGN = { fr: 'Alexandre<br>MyVisaDTV · contact@myvisadtv.com', en: 'Alexandre<br>MyVisaDTV · contact@myvisadtv.com', de: 'Alexandre<br>MyVisaDTV · contact@myvisadtv.com' };\nconst HELLO = { fr: 'Bonjour', en: 'Hello', de: 'Hallo' };\nfunction bouton(href, label) {\n  return `<p style=\"margin:28px 0\"><a href=\"${href}\" style=\"background:#16233f;color:#fff;padding:14px 22px;border-radius:999px;text-decoration:none;font-weight:600;display:inline-block\">${label}</a></p>`;\n}\nfunction mail(lang, name, paras, cta) {\n  const l = ['fr', 'en', 'de'].includes(lang) ? lang : 'fr';\n  const body = paras.map((p) => `<p style=\"margin:0 0 14px\">${p}</p>`).join('');\n  const html = `<div style=\"font-family:-apple-system,Segoe UI,Arial,sans-serif;font-size:15px;line-height:1.55;color:#1f2937;max-width:560px\">`\n    + `<p style=\"margin:0 0 14px\">${HELLO[l]} ${first(name)},</p>${body}${cta ? bouton(cta[0], cta[1]) : ''}<p style=\"margin:24px 0 0\">${SIGN[l]}</p></div>`;\n  const text = [`${HELLO[l]} ${String(name || '').split(' ')[0]},`, ...paras.map((p) => p.replace(/<br>/g, '\\n').replace(/<[^>]+>/g, '')), cta ? `${cta[1]} : ${cta[0]}` : '', 'Alexandre — MyVisaDTV'].filter(Boolean).join('\\n\\n');\n  return { html, text };\n}\n\n// ⚙️ RÉGLAGE : collez ici le lien direct « Laisser un avis » (Google Business ou Trustpilot).\nconst LIEN_AVIS = 'COLLER_LE_LIEN_AVIS_ICI';\nif (LIEN_AVIS.startsWith('COLLER')) return [];\nconst T = {\n  fr: { objet: 'Félicitations pour votre visa DTV 🎉', p: ['Encore bravo pour votre visa DTV, et merci de nous avoir fait confiance.', 'Votre avis aide d’autres francophones à préparer leur dossier sereinement. Il vous prendra une minute :', 'En répondant à cet e-mail avec « OK pour publier », vous nous autorisez aussi à afficher votre prénom et votre avis sur notre site.'], cta: 'Laisser mon avis' },\n  en: { objet: 'Congratulations on your DTV visa 🎉', p: ['Congratulations again on your DTV visa, and thank you for trusting us.', 'Your review helps others prepare their application with confidence. It takes one minute:', 'If you reply “OK to publish”, you also allow us to show your first name and review on our website.'], cta: 'Leave my review' },\n  de: { objet: 'Glückwunsch zu Ihrem DTV-Visum 🎉', p: ['Herzlichen Glückwunsch zu Ihrem DTV-Visum und danke für Ihr Vertrauen.', 'Ihre Bewertung hilft anderen, ihren Antrag entspannt vorzubereiten. Sie dauert eine Minute:', 'Wenn Sie mit „OK zur Veröffentlichung“ antworten, dürfen wir Ihren Vornamen und Ihre Bewertung auf unserer Website zeigen.'], cta: 'Bewertung abgeben' },\n};\nreturn $input.all().filter((i) => i.json.id && i.json.email).map((i) => {\n  const l = T[i.json.lang] ? i.json.lang : 'fr';\n  const m = mail(l, i.json.client_name, T[l].p, [LIEN_AVIS, T[l].cta]);\n  return { json: { id: i.json.id, to: i.json.email, objet: T[l].objet, html: m.html, text: m.text } };\n});\n"
      },
