    {
      "parameters": {
        "toolDescription": "Envoie un e-mail depuis contact@myvisadtv.com, avec la signature MyVisaDTV (logo) dans la langue indiquée. À utiliser UNIQUEMENT après accord explicite d'Alexandre sur le brouillon.",
        "fromEmail": "Alexandre - myvisaDTV <contact@myvisadtv.com>",
        "toEmail": "={{ $fromAI('destinataire', 'Adresse e-mail du destinataire', 'string') }}",
        "subject": "={{ $fromAI('objet', 'Objet de l e-mail', 'string') }}",
        "emailFormat": "both",
        "text": "={{ $fromAI('message', 'Texte complet de l e-mail, sans signature', 'string') }}\n\n--\nAlexandre · MyVisaDTV\nmyvisadtv.com · WhatsApp +66 63 174 7492",
        "options": {
          "appendAttribution": false
        },
        "html": "={{ (() => { const t = String($fromAI('message', 'Texte complet de l e-mail, sans signature', 'string')); const lang = String($fromAI('langue', 'Langue de l e-mail : fr ou en', 'string')).toLowerCase().startsWith('en') ? 'en' : 'fr'; const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); const corps = esc(t).split(/\\n{2,}/).map((p) => '<p style=\"margin:0 0 14px;\">' + p.replace(/\\n/g, '<br>') + '</p>').join(''); const sig = lang === 'en' ? \"<table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" role=\\\"presentation\\\" style=\\\"border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;color:#1F2430;\\\"><tr><td valign=\\\"middle\\\" style=\\\"padding:0 18px 0 0;\\\"><a href=\\\"https://myvisadtv.com/en/\\\" style=\\\"text-decoration:none;\\\"><img src=\\\"https://myvisadtv.com/images/logo-dtv-thailand.png\\\" width=\\\"132\\\" height=\\\"88\\\" alt=\\\"MyVisaDTV, DTV Thailand Visa Services\\\" style=\\\"display:block;border:0;width:132px;height:88px;\\\"></a></td><td valign=\\\"middle\\\" style=\\\"border-left:2px solid #C9A24C;padding:2px 0 2px 18px;\\\"><div style=\\\"font-family:Georgia,'Times New Roman',serif;font-size:19px;font-weight:bold;color:#16233F;line-height:1.2;\\\">Alexandre</div><div style=\\\"font-size:13px;color:#2F6F62;font-weight:bold;line-height:1.5;padding-top:2px;\\\">Founder · MyVisaDTV</div><div style=\\\"font-size:12px;color:#6F675B;line-height:1.5;\\\">DTV visa support for Thailand</div><table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" role=\\\"presentation\\\" style=\\\"border-collapse:collapse;margin-top:8px;font-size:12.5px;line-height:1.7;\\\"><tr><td style=\\\"color:#C9A24C;font-weight:bold;padding-right:6px;\\\">WhatsApp</td><td><a href=\\\"https://wa.me/66631747492\\\" style=\\\"color:#1F2430;text-decoration:none;\\\">+66 63 174 7492</a></td></tr><tr><td style=\\\"color:#C9A24C;font-weight:bold;padding-right:6px;\\\">Email</td><td><a href=\\\"mailto:contact@myvisadtv.com\\\" style=\\\"color:#1F2430;text-decoration:none;\\\">contact@myvisadtv.com</a></td></tr><tr><td style=\\\"color:#C9A24C;font-weight:bold;padding-right:6px;\\\">Web</td><td><a href=\\\"https://myvisadtv.com/en/\\\" style=\\\"color:#1F2430;text-decoration:none;\\\">myvisadtv.com</a></td></tr></table><table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" role=\\\"presentation\\\" style=\\\"border-collapse:collapse;margin-top:10px;\\\"><tr><td style=\\\"background:#16233F;border-radius:6px;\\\"><a href=\\\"https://cal.com/myvisadtv/appel-decouverte-dtv\\\" style=\\\"display:inline-block;padding:7px 14px;font-size:12px;font-weight:bold;color:#FFFFFF;text-decoration:none;\\\">Book a free 10-minute call</a></td></tr></table></td></tr><tr><td colspan=\\\"2\\\" style=\\\"padding-top:12px;font-size:10.5px;line-height:1.4;color:#9C9284;\\\"> MyVisaDTV is a private support agency. We are not the Thai government and cannot guarantee that a visa will be granted. </td></tr></table>\" : \"<table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" role=\\\"presentation\\\" style=\\\"border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;color:#1F2430;\\\"><tr><td valign=\\\"middle\\\" style=\\\"padding:0 18px 0 0;\\\"><a href=\\\"https://myvisadtv.com/\\\" style=\\\"text-decoration:none;\\\"><img src=\\\"https://myvisadtv.com/images/logo-dtv-thailand.png\\\" width=\\\"132\\\" height=\\\"88\\\" alt=\\\"MyVisaDTV, DTV Thailand Visa Services\\\" style=\\\"display:block;border:0;width:132px;height:88px;\\\"></a></td><td valign=\\\"middle\\\" style=\\\"border-left:2px solid #C9A24C;padding:2px 0 2px 18px;\\\"><div style=\\\"font-family:Georgia,'Times New Roman',serif;font-size:19px;font-weight:bold;color:#16233F;line-height:1.2;\\\">Alexandre</div><div style=\\\"font-size:13px;color:#2F6F62;font-weight:bold;line-height:1.5;padding-top:2px;\\\">Fondateur · MyVisaDTV</div><div style=\\\"font-size:12px;color:#6F675B;line-height:1.5;\\\">Accompagnement visa DTV pour la Thaïlande</div><table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" role=\\\"presentation\\\" style=\\\"border-collapse:collapse;margin-top:8px;font-size:12.5px;line-height:1.7;\\\"><tr><td style=\\\"color:#C9A24C;font-weight:bold;padding-right:6px;\\\">WhatsApp</td><td><a href=\\\"https://wa.me/66631747492\\\" style=\\\"color:#1F2430;text-decoration:none;\\\">+66 63 174 7492</a></td></tr><tr><td style=\\\"color:#C9A24C;font-weight:bold;padding-right:6px;\\\">E-mail</td><td><a href=\\\"mailto:contact@myvisadtv.com\\\" style=\\\"color:#1F2430;text-decoration:none;\\\">contact@myvisadtv.com</a></td></tr><tr><td style=\\\"color:#C9A24C;font-weight:bold;padding-right:6px;\\\">Site</td><td><a href=\\\"https://myvisadtv.com/\\\" style=\\\"color:#1F2430;text-decoration:none;\\\">myvisadtv.com</a></td></tr></table><table cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" role=\\\"presentation\\\" style=\\\"border-collapse:collapse;margin-top:10px;\\\"><tr><td style=\\\"background:#16233F;border-radius:6px;\\\"><a href=\\\"https://cal.com/myvisadtv/appel-decouverte-dtv\\\" style=\\\"display:inline-block;padding:7px 14px;font-size:12px;font-weight:bold;color:#FFFFFF;text-decoration:none;\\\">Réserver un appel gratuit de 10 min</a></td></tr></table></td></tr><tr><td colspan=\\\"2\\\" style=\\\"padding-top:12px;font-size:10.5px;line-height:1.4;color:#9C9284;\\\"> MyVisaDTV est une agence privée d'accompagnement. Nous ne sommes pas l'administration thaïlandaise et ne garantissons pas l'obtention du visa. </td></tr></table>\"; return '<div style=\"font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.55;color:#1F2430;\">' + corps + '<div style=\"margin-top:18px;\">' + sig + '</div></div>'; })() }}"
