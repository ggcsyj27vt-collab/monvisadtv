---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CalButton from '../components/CalButton.astro';
import type { Locale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** JSON-LD supplémentaire (ex. FAQPage) à injecter en plus du schéma d'organisation par défaut */
  structuredData?: Record<string, any>;
  /** Langue de la page. Par défaut 'fr'. */
  lang?: Locale;
  /** Mettre à true si cette page existe aussi en /en/ et /de/ (ajoute les balises hreflang). */
  translated?: boolean;
  /** Mettre à true pour empêcher l'indexation (pages privées : admin, espace client). */
  noindex?: boolean;
}
const { title, description, structuredData, lang = 'fr', translated = false, noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Chemin sans préfixe de langue, pour construire les variantes hreflang.
const basePath = Astro.url.pathname.replace(/^\/(en|de)(\/|$)/, '/');
const hreflangLinks = translated
  ? [
      { hreflang: 'fr', href: new URL(basePath, Astro.site).toString() },
      { hreflang: 'en', href: new URL(`/en${basePath}`.replace(/\/{2,}/g, '/'), Astro.site).toString() },
      { hreflang: 'de', href: new URL(`/de${basePath}`.replace(/\/{2,}/g, '/'), Astro.site).toString() },
      { hreflang: 'x-default', href: new URL(`/en${basePath}`.replace(/\/{2,}/g, '/'), Astro.site).toString() },
    ]
  : [];

const ogLocale = { fr: 'fr_FR', en: 'en_US', de: 'de_DE' }[lang];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'MyVisaDTV',
  url: 'https://myvisadtv.com',
  logo: 'https://myvisadtv.com/images/logo-dtv-thailand.png',
  image: 'https://myvisadtv.com/images/logo-dtv-thailand.png',
  description:
    "Cabinet de conseil indépendant spécialisé dans l'accompagnement des demandes de Destination Thailand Visa (DTV).",
  areaServed: 'FR',
  serviceType: 'Accompagnement administratif visa',
  priceRange: '€€',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    {lang === 'fr' && Astro.url.pathname === '/' && (
      <script is:inline>
        // Langue principale : anglais. Sur l'accueil français, on envoie vers /en/
        // (ou /de/) les visiteurs dont le navigateur n'est pas en français, sauf
        // s'ils ont choisi le français dans le sélecteur de langue. Les robots
        // des moteurs de recherche ne sont jamais redirigés.
        (function () {
          try {
            if (/bot|crawl|spider|slurp|lighthouse|preview/i.test(navigator.userAgent)) return;
            var choice = localStorage.getItem('lang-choice');
            var target;
            if (choice) {
              target = choice;
            } else {
              var langs = (navigator.languages || [navigator.language || '']).map(function (l) { return String(l).slice(0, 2).toLowerCase(); });
              target = langs.filter(function (l) { return l === 'fr' || l === 'en' || l === 'de'; })[0] || 'en';
            }
            if (target === 'fr') return;
            location.replace((target === 'de' ? '/de/' : '/en/') + location.search + location.hash);
          } catch (e) {}
        })();
      </script>
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-256.png" />
    <title>{title} | MyVisaDTV</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {hreflangLinks.map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={l.href} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={`${title} | MyVisaDTV`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://myvisadtv.com/images/logo-dtv-thailand.png" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary" />

    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="503817a4-f79c-4a11-8dc4-d749e98276e7"></script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body class="bg-papier font-sans text-encre antialiased">
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <CalButton lang={lang} />
    <WhatsAppButton />
    <!-- Mesure d'audience Umami : suivi automatique des clics importants (conversions) -->
    <script is:inline>
      (function () {
        var rules = [
          [/buy\.stripe\.com\/7sY5kE2oogXg4r1fQc14403/, 'Paiement 99 € (clic)'],
          [/buy\.stripe\.com\/aFafZiaUU6iC9LlfQc14402/, 'Paiement 699 € (clic)'],
          [/buy\.stripe\.com\/aFa00ke768qKaPp33q14404/, 'Paiement 600 € (clic)'],
          [/cal\.com\//, 'Réserver un appel (lien)'],
          [/wa\.me\//, 'WhatsApp'],
          [/\/fiche-renseignement\/$/, 'Ouvrir la fiche'],
          [/\/visa-dtv\/verification-dossier\/$/, 'Voir offre 99 €'],
          [/\/visa-dtv\/demande-accompagnee\/$/, 'Voir offre 699 €'],
        ];
        function tag() {
          document.querySelectorAll('a[href]').forEach(function (a) {
            if (a.hasAttribute('data-umami-event')) return;
            var href = a.getAttribute('href') || '';
            for (var i = 0; i < rules.length; i++) {
              if (rules[i][0].test(href)) {
                a.setAttribute('data-umami-event', rules[i][1]);
                a.setAttribute('data-umami-event-page', location.pathname);
                break;
              }
            }
          });
          document.querySelectorAll('form').forEach(function (f) {
            if (f.dataset.umamiTracked) return;
            f.dataset.umamiTracked = '1';
            f.addEventListener('submit', function () {
              if (window.umami) window.umami.track('Fiche envoyée', { page: location.pathname });
            });
          });
        }
        tag();
      })();
    </script>
    <!-- Animations discrètes : apparition au défilement + survol des boutons -->
    <style is:global>
      .article-content table {
        display: block;
        max-width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      @media (max-width: 767px) {
        body > footer {
          padding-bottom: 5.5rem;
        }
      }
      @media (prefers-reduced-motion: no-preference) {
        .reveal {
          opacity: 0;
          transform: translateY(18px);
          transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
        }
        .reveal.is-visible {
          opacity: 1;
          transform: none;
        }
        .btn-primary,
        .btn-secondary,
        .btn-on-dark {
          transition: transform 0.45s var(--ease-spring), box-shadow 0.3s ease, background-color 0.2s ease, color 0.2s ease;
        }
        .btn-primary:hover,
        .btn-secondary:hover,
        .btn-on-dark:hover {
          transform: translateY(-2px);
        }
        .btn-primary:hover {
          box-shadow: 0 10px 22px -10px rgba(27, 38, 79, 0.45);
        }
        /* Retour immédiat à l'appui, prioritaire sur le survol */
        .btn-primary:active,
        .btn-secondary:active,
        .btn-on-dark:active {
          transform: scale(0.97);
          transition-duration: 0.1s;
        }
      }
    </style>
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var sel = 'main section h1, main section h2, main section .eyebrow, main section > div > p, main .grid > *, main ol > li, main .max-w-2xl > *, main .max-w-xl > p';
        var all = Array.prototype.slice.call(document.querySelectorAll(sel));
        var set = new Set(all);
        var targets = all.filter(function (el) {
          var p = el.parentElement;
          while (p && p.tagName !== 'MAIN') {
            if (set.has(p)) return false;
            p = p.parentElement;
          }
          return !el.closest('#cal-inline');
        });
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -6% 0px', threshold: 0.05 });
        targets.forEach(function (el) {
          var i = Array.prototype.indexOf.call(el.parentElement.children, el);
          el.style.transitionDelay = Math.min(i, 5) * 70 + 'ms';
          el.classList.add('reveal');
          io.observe(el);
        });
      })();
    </script>
    <script>
      // Barre de navigation : ombre discrète uniquement quand le contenu défile dessous
      const header = document.getElementById('site-header');
      const onScroll = () => {
        if (!header) return;
        if (window.scrollY > 4) header.setAttribute('data-scrolled', '');
        else header.removeAttribute('data-scrolled');
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>
