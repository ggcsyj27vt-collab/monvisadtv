---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import type { Locale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** JSON-LD supplémentaire (ex. FAQPage) à injecter en plus du schéma d'organisation par défaut */
  structuredData?: Record<string, any>;
  /** Langue de la page. Par défaut 'fr'. */
  lang?: Locale;
  /** Mettre à true si cette page existe aussi en /en/ et /de/ (ajoute les balises hreflang). */
  translated?: boolean;
}
const { title, description, structuredData, lang = 'fr', translated = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Chemin sans préfixe de langue, pour construire les variantes hreflang.
const basePath = Astro.url.pathname.replace(/^\/(en|de)(\/|$)/, '/');
const hreflangLinks = translated
  ? [
      { hreflang: 'fr', href: new URL(basePath, Astro.site).toString() },
      { hreflang: 'en', href: new URL(`/en${basePath}`.replace(/\/{2,}/g, '/'), Astro.site).toString() },
      { hreflang: 'de', href: new URL(`/de${basePath}`.replace(/\/{2,}/g, '/'), Astro.site).toString() },
      { hreflang: 'x-default', href: new URL(basePath, Astro.site).toString() },
    ]
  : [];

const ogLocale = { fr: 'fr_FR', en: 'en_US', de: 'de_DE' }[lang];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'MyVisaDTV',
  url: 'https://myvisadtv.com',
  logo: 'https://myvisadtv.com/images/logo-dtv-thailand.png',
  image: 'https://myvisadtv.com/images/logo-dtv-thailand.png',
  description:
    "Cabinet de conseil indépendant spécialisé dans l'accompagnement des demandes de Destination Thailand Visa (DTV).",
  areaServed: 'FR',
  serviceType: 'Accompagnement administratif visa',
  priceRange: '€€',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-256.png" />
    <title>{title} | MyVisaDTV</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {hreflangLinks.map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={l.href} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={`${title} | MyVisaDTV`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://myvisadtv.com/images/logo-dtv-thailand.png" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body class="bg-papier font-sans text-encre antialiased">
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppButton />
  </body>
</html>
