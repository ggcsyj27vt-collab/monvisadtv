---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Fiche de renseignement"
  description="Répondez en quelques minutes pour recevoir un premier avis gratuit et sans engagement sur votre éligibilité au visa DTV."
>
  <section class="border-b border-sable-light bg-papier">
    <div class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
      <p class="eyebrow mb-4">Étape 1 — sans engagement</p>
      <h1 class="max-w-2xl font-display text-4xl leading-tight text-indigo md:text-5xl">
        Parlez-nous de votre projet
      </h1>
      <p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-encre/80">
        Cinq minutes suffisent. Votre conseiller revient vers vous avec un premier avis sur
        votre éligibilité, avant tout paiement.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="grid gap-14 md:grid-cols-[1fr_0.7fr]">
      <!--
        Formulaire statique : l'attribut action ci-dessous est un espace réservé.
        À connecter à un service de traitement de formulaire (ex. Formspree) ou à une
        fonction serverless, conformément à CLAUDE.md ("Formulaires : à préciser").
      -->
      <form
        method="POST"
        action="https://formspree.io/f/mgaegdgv"
        class="space-y-8"
        id="fiche-form"
        novalidate
      >
        <!-- Barre de progression -->
        <div class="space-y-2">
          <div class="flex items-center justify-between font-sans text-xs font-medium text-encre/70">
            <span id="step-label">Étape 1 sur 3 — Vos coordonnées</span>
            <span id="step-count">1/3</span>
          </div>
          <div class="h-1.5 w-full overflow-hidden rounded-full bg-sable-light">
            <div
              id="progress-bar"
              class="h-full rounded-full bg-jade transition-all duration-300 ease-out"
              style="width: 33.3333%"
            ></div>
          </div>
        </div>

        <fieldset class="form-step space-y-5" data-step="1">
          <legend class="font-display text-xl text-indigo">Vos coordonnées</legend>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="prenom" class="block font-sans text-sm font-medium text-encre">Prénom</label>
              <input
                type="text" id="prenom" name="prenom" required autocomplete="given-name"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
            <div>
              <label for="nom" class="block font-sans text-sm font-medium text-encre">Nom</label>
              <input
                type="text" id="nom" name="nom" required autocomplete="family-name"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="email" class="block font-sans text-sm font-medium text-encre">Email</label>
              <input
                type="email" id="email" name="email" required autocomplete="email"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
            <div>
              <label for="telephone" class="block font-sans text-sm font-medium text-encre">Téléphone (avec indicatif)</label>
              <input
                type="tel" id="telephone" name="telephone" autocomplete="tel"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="pays" class="block font-sans text-sm font-medium text-encre">Pays de résidence actuel</label>
            <input
              type="text" id="pays" name="pays" required
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            />
          </div>
        </fieldset>

        <fieldset class="form-step space-y-5" data-step="2" hidden>
          <legend class="font-display text-xl text-indigo">Votre situation</legend>

          <div>
            <label for="statut" class="block font-sans text-sm font-medium text-encre">Quelle situation vous correspond le mieux ?</label>
            <select
              id="statut" name="statut" required
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            >
              <option value="">Sélectionnez une option</option>
              <option value="teletravailleur">Télétravailleur salarié à l'étranger</option>
              <option value="independant">Indépendant / freelance</option>
              <option value="conjoint">Conjoint(e) d'un ressortissant thaïlandais</option>
              <option value="activite-encadree">Formation, stage ou activité culturelle/sportive encadrée</option>
              <option value="autre">Autre situation</option>
            </select>
          </div>

          <div>
            <label for="activite" class="block font-sans text-sm font-medium text-encre">Décrivez brièvement votre activité professionnelle</label>
            <textarea
              id="activite" name="activite" rows="3" required
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            ></textarea>
          </div>

          <div>
            <label for="revenu" class="block font-sans text-sm font-medium text-encre">Fourchette de revenus mensuels (indicative)</label>
            <select
              id="revenu" name="revenu"
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            >
              <option value="">Préférez ne pas répondre pour l'instant</option>
              <option value="moins-2000">Moins de 2 000 €</option>
              <option value="2000-4000">Entre 2 000 € et 4 000 €</option>
              <option value="4000-6000">Entre 4 000 € et 6 000 €</option>
              <option value="plus-6000">Plus de 6 000 €</option>
            </select>
          </div>
        </fieldset>

        <fieldset class="form-step space-y-5" data-step="3" hidden>
          <legend class="font-display text-xl text-indigo">Votre projet</legend>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="depart" class="block font-sans text-sm font-medium text-encre">Départ envisagé</label>
              <input
                type="month" id="depart" name="depart"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
            <div>
              <label for="duree" class="block font-sans text-sm font-medium text-encre">Durée de séjour envisagée</label>
              <select
                id="duree" name="duree"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              >
                <option value="">Sélectionnez une option</option>
                <option value="moins-6-mois">Moins de 6 mois</option>
                <option value="6-12-mois">6 à 12 mois</option>
                <option value="plus-1-an">Plus d'un an</option>
                <option value="indetermine">Encore indéterminée</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block font-sans text-sm font-medium text-encre">Informations complémentaires (facultatif)</label>
            <textarea
              id="message" name="message" rows="4"
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            ></textarea>
          </div>
        </fieldset>

        <div class="form-step space-y-6" data-step="3-extra" hidden>
          <div class="flex items-start gap-3">
            <input type="checkbox" id="rgpd" name="rgpd" required class="mt-1 h-4 w-4 border-sable-light" />
            <label for="rgpd" class="font-sans text-xs leading-relaxed text-encre/80">
              J'accepte que les informations transmises via ce formulaire soient utilisées par
              MyVisaDTV pour évaluer mon éligibilité et me recontacter. Voir notre
              <a href="/confidentialite/" class="underline hover:text-indigo">politique de confidentialité</a>.
            </label>
          </div>
        </div>

        <!-- Navigation entre étapes -->
        <div class="flex items-center justify-between pt-2">
          <button
            type="button"
            id="btn-prev"
            class="font-sans text-sm font-medium text-encre/70 underline decoration-sable-light underline-offset-4 hover:text-indigo"
            hidden
          >
            ← Étape précédente
          </button>
          <div class="ml-auto flex gap-3">
            <button type="button" id="btn-next" class="btn-primary">
              Étape suivante →
            </button>
            <button type="submit" id="btn-submit" class="btn-primary" hidden>
              Envoyer ma fiche de renseignement
            </button>
          </div>
        </div>
      </form>

      <script>
        const form = document.getElementById('fiche-form') as HTMLFormElement;
        const steps = Array.from(form.querySelectorAll<HTMLElement>('.form-step'));
        // Étapes "visibles" pour la barre de progression (la case RGPD fait partie de l'étape 3)
        const stepGroups = [
          [steps[0]], // étape 1 : coordonnées
          [steps[1]], // étape 2 : situation
          [steps[2], steps[3]], // étape 3 : projet + RGPD
        ];
        const totalSteps = stepGroups.length;
        let current = 0;

        const stepLabel = document.getElementById('step-label')!;
        const stepCount = document.getElementById('step-count')!;
        const progressBar = document.getElementById('progress-bar')!;
        const btnPrev = document.getElementById('btn-prev') as HTMLButtonElement;
        const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
        const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;

        const labels = ['Vos coordonnées', 'Votre situation', 'Votre projet'];

        function render() {
          stepGroups.forEach((group, i) => {
            group.forEach((el) => {
              el.hidden = i !== current;
            });
          });

          stepLabel.textContent = `Étape ${current + 1} sur ${totalSteps} — ${labels[current]}`;
          stepCount.textContent = `${current + 1}/${totalSteps}`;
          progressBar.style.width = `${((current + 1) / totalSteps) * 100}%`;

          btnPrev.hidden = current === 0;
          btnNext.hidden = current === totalSteps - 1;
          btnSubmit.hidden = current !== totalSteps - 1;
        }

        function currentStepIsValid(): boolean {
          const group = stepGroups[current];
          let valid = true;
          group.forEach((el) => {
            el.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea').forEach((field) => {
              if (!field.checkValidity()) {
                valid = false;
                field.reportValidity();
              }
            });
          });
          return valid;
        }

        btnNext.addEventListener('click', () => {
          if (!currentStepIsValid()) return;
          if (current < totalSteps - 1) {
            current += 1;
            render();
            form.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });

        btnPrev.addEventListener('click', () => {
          if (current > 0) {
            current -= 1;
            render();
            form.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });

        // Juste avant l'envoi réel, on révèle toutes les étapes : les champs
        // déjà remplis restent valides, et aucun champ masqué ne peut bloquer
        // silencieusement la validation native du navigateur.
        form.addEventListener('submit', (e) => {
          if (!currentStepIsValid()) {
            e.preventDefault();
            return;
          }
          steps.forEach((step) => {
            step.hidden = false;
          });
        });

        render();
      </script>

      <aside class="h-fit space-y-6">
        <div class="rounded-lg border border-sable-light bg-jade-bg p-8">
          <h2 class="font-display text-lg text-indigo">Ce qui se passe ensuite</h2>
          <ol class="mt-5 space-y-4 font-sans text-sm leading-relaxed text-encre/80">
            <li><span class="font-mono text-xs text-jade">01</span> — Un conseiller étudie votre situation sous 48h ouvrées.</li>
            <li><span class="font-mono text-xs text-jade">02</span> — Vous recevez un premier avis sur votre éligibilité, gratuit et sans engagement.</li>
            <li><span class="font-mono text-xs text-jade">03</span> — Si vous souhaitez continuer, nous vous présentons la formule à 700 € en détail.</li>
          </ol>
        </div>

        <div class="rounded-lg border border-sable-light bg-white p-8">
          <h2 class="font-display text-lg text-indigo">Vous préférez échanger directement ?</h2>
          <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
            Scannez ce QR code pour nous écrire sur WhatsApp — pratique si vous êtes déjà en
            Thaïlande ou si vous préférez poser vos questions avant de remplir le formulaire.
          </p>
          <img
            src="/images/whatsapp-qr.jpg"
            alt="QR code pour contacter MyVisaDTV sur WhatsApp"
            class="mx-auto mt-5 h-36 w-36 rounded-md border border-sable-light"
            width="602"
            height="602"
          />
          <a
            href="https://wa.me/66631747492?text=Bonjour%2C%20je%20souhaite%20en%20savoir%20plus%20sur%20l%27accompagnement%20visa%20DTV."
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 block text-center font-sans text-sm font-semibold text-jade hover:text-jade-light"
          >
            Ou cliquez ici sur mobile →
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
