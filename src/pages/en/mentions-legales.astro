---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Legal notice"
  description="Legal notice for MyVisaDTV."
  lang="en"
  translated
>
  <section class="section max-w-3xl">
    <h1 class="font-display text-4xl text-indigo">Legal notice</h1>

    <div class="mt-10 space-y-8 font-sans text-sm leading-relaxed text-encre/85">
      <p class="rounded-sm border border-or-dark/40 bg-jade-bg px-5 py-4 font-mono text-xs text-encre/70">
        This is an informational translation. The French version of this page is the
        legally binding one. Two details are still pending below (business registration
        number and address).
      </p>

      <div>
        <h2 class="font-display text-xl text-indigo">Site publisher</h2>
        <p class="mt-2">
          Alexandre Delesalle, trading as MyVisaDTV — Sole trader (French micro-entreprise)
          — SIRET: [pending verification] — Address: [to be added] — Contact email:
          contact@myvisadtv.com
        </p>
      </div>

      <div>
        <h2 class="font-display text-xl text-indigo">Hosting</h2>
        <p class="mt-2">Netlify, Inc. — 101 2nd Street, San Francisco, CA 94105, USA — www.netlify.com</p>
      </div>

      <div>
        <h2 class="font-display text-xl text-indigo">Publication director</h2>
        <p class="mt-2">Alexandre Delesalle</p>
      </div>

      <div>
        <h2 class="font-display text-xl text-indigo">Nature of the service</h2>
        <p class="mt-2">
          MyVisaDTV is an independent consulting service specialising in administrative
          support for Destination Thailand Visa (DTV) applications. MyVisaDTV is neither a
          Thai administration, nor a consulate, nor an official body, and does not
          guarantee that a visa will be granted.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
