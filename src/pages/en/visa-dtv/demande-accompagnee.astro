---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CheckItem from '../../../components/CheckItem.astro';
import StepCard from '../../../components/StepCard.astro';
import FaqItem from '../../../components/FaqItem.astro';
import CalInline from '../../../components/CalInline.astro';
import DerniereMiseAJour from '../../../components/DerniereMiseAJour.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Assisted DTV visa application',
      serviceType: 'Administrative visa support',
      provider: {
        '@type': 'ProfessionalService',
        name: 'MyVisaDTV',
        url: 'https://myvisadtv.com',
      },
      areaServed: 'FR',
      offers: {
        '@type': 'Offer',
        price: '699',
        priceCurrency: 'EUR',
        url: 'https://myvisadtv.com/en/visa-dtv/demande-accompagnee/',
        availability: 'https://schema.org/InStock',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Do I have to pay the €699 before the diagnostic?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. The initial diagnostic, based on your intake form, is free and without obligation. Payment only happens once you agree to start building your file.',
          },
        },
        {
          '@type': 'Question',
          name: 'What happens if my application is refused?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'We review the reasons for the decision with you and look at the options available. The terms of any further support are communicated clearly on a case-by-case basis.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I pay in instalments?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'A payment plan may be offered depending on the stage of the process. This is discussed with your advisor during your first conversation.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does payment of the €699 work?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Payment happens after the free diagnostic, once you have agreed to start building your file. It can be made online, by card.',
          },
        },
        {
          '@type': 'Question',
          name: 'Are the official visa fees included in the €699?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, the official visa fees applicable to your application are included in the package, within the terms specified when you order. Sworn translation or document legalisation fees remain your responsibility.',
          },
        },
        {
          '@type': 'Question',
          name: 'Can I cancel during the process?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes, you remain free to do so at any time. The terms of any cancellation during the process are specified before payment, so you can commit with full knowledge.',
          },
        },
        {
          '@type': 'Question',
          name: "Who files the application and deals with the embassy?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "We do. We submit your application on the official e-Visa portal and answer the embassy's requests made through that portal, such as additional documents. The only thing we can't do for you is appear in person if the embassy asks to see you. In that case, we prepare you for the appointment.",
          },
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Assisted DTV visa application — €699"
  description="The full MyVisaDTV package for €699: complete file preparation, application filed by us and follow-up until the decision. Official visa fees included."
  structuredData={structuredData}
  lang="en"
  translated
>
  <!-- Hero produit -->
  <section class="border-b border-sable-light bg-papier">
    <div class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-24">
      <p class="eyebrow mb-4">Full package</p>
      <div class="grid gap-12 md:grid-cols-[1.1fr_0.9fr] md:items-start">
        <div>
          <h1 class="font-display text-4xl leading-tight text-indigo md:text-5xl">
            DTV visa application, supported from start to finish
          </h1>
          <p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-encre/80">
            We prepare your complete file, file it for you, then follow it through to the Thai
            authorities' decision. On your side, you send us your documents and approve the file
            before we submit it.
          </p>
          <div class="mt-8">
            <DerniereMiseAJour date="2026-11-17" />
          </div>
        </div>

        <div class="rounded-lg border border-sable-light bg-white p-8">
          <p class="font-mono text-xs uppercase tracking-wide text-sable">Current offer</p>
          <p class="-mt-1 font-display text-5xl text-indigo">€699</p>
          <p class="mt-2 font-sans text-sm text-encre/70">Official visa fees included, within the rate applicable at the time of filing.</p>
          <a href="/en/fiche-renseignement/" class="btn-primary mt-6 w-full">Start my application</a>
          <a
            href="https://buy.stripe.com/aFafZiaUU6iC9LlfQc14402"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary mt-3 w-full"
          >
            Already decided? Pay now
          </a>
          <p class="mt-4 font-sans text-xs text-sable">
            Sworn translation or document legalisation fees remain your responsibility and
            are not included in this price.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ce qui est inclus -->
  <section class="section">
    <p class="eyebrow mb-3">What's included</p>
    <h2 class="max-w-xl font-display text-3xl text-indigo">What we do for you, in 3 steps</h2>

    <div class="mt-10 grid gap-10 md:grid-cols-3">
      <div>
        <p class="font-display text-2xl text-or-dark">01</p>
        <h3 class="mt-2 font-display text-xl text-indigo">Complete file preparation</h3>
        <ul class="mt-5 space-y-4">
          <CheckItem variant="gold">Detailed eligibility diagnostic (professional status, income, family situation)</CheckItem>
          <CheckItem variant="gold">Personalised list of documents to gather</CheckItem>
          <CheckItem variant="gold">Review and compliance check of every document</CheckItem>
          <CheckItem variant="gold">Complete application file, ready to be submitted</CheckItem>
        </ul>
      </div>
      <div>
        <p class="font-display text-2xl text-or-dark">02</p>
        <h3 class="mt-2 font-display text-xl text-indigo">Filing the application</h3>
        <ul class="mt-5 space-y-4">
          <CheckItem variant="gold">We submit your application on the official Thai e-Visa portal</CheckItem>
          <CheckItem variant="gold">We pay the official visa fees, included in the €699</CheckItem>
          <CheckItem variant="gold">You're notified as soon as the application is filed</CheckItem>
        </ul>
      </div>
      <div>
        <p class="font-display text-2xl text-or-dark">03</p>
        <h3 class="mt-2 font-display text-xl text-indigo">Follow-up until the decision</h3>
        <ul class="mt-5 space-y-4">
          <CheckItem variant="gold">Follow-up of your application until the decision is notified</CheckItem>
          <CheckItem variant="gold">Answers to the embassy's requests for additional documents</CheckItem>
          <CheckItem variant="gold">A dedicated advisor, reachable by email throughout the process</CheckItem>
          <CheckItem variant="gold">Interview preparation, if the embassy asks for one</CheckItem>
        </ul>
      </div>
    </div>

    <div class="mt-12 rounded-lg border border-sable-light bg-white p-8">
      <h3 class="font-display text-xl text-indigo">What you do on your side</h3>
      <ul class="mt-4 space-y-2 font-sans text-sm leading-relaxed text-encre/80">
        <li>— Gather the requested documents and send them to us through your secure space.</li>
        <li>— Review the complete file and give us your go-ahead before we submit it.</li>
        <li>— Be outside Thailand when the application is filed, as the procedure requires.</li>
        <li>— Go to the embassy only if it asks to see you in person.</li>
      </ul>
    </div>
  </section>

  <!-- Ce qui n'est pas inclus / honnêteté -->
  <section class="section border-t border-sable-light">
    <div class="rounded-lg border border-sable-light bg-white/60 p-8 md:p-10">
      <h2 class="font-display text-2xl text-indigo">What this package does not cover</h2>
      <ul class="mt-6 space-y-4 font-sans text-sm leading-relaxed text-encre/80">
        <li>— Getting the visa is never guaranteed: the decision belongs to the Thai authorities.</li>
        <li>— Sworn translation or document legalisation fees remain your responsibility.</li>
        <li>— Procedures once you are in Thailand (stay reports, renewals) are not included and are handled as separate support.</li>
      </ul>
    </div>
  </section>

  <!-- Vérification du dossier (99 €) -->
  <section class="section">
    <div class="flex flex-wrap items-center justify-between gap-6 rounded-lg border border-sable-light bg-white p-8 md:p-10">
      <div class="max-w-xl">
        <p class="eyebrow mb-2">Applying on your own?</p>
        <h2 class="font-display text-2xl text-indigo">Have your file checked for €99</h2>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">Missing documents, compliance with official requirements, consistency between your documents: written report within 48 business hours. The €99 is deducted if you then switch to the full package.</p>
      </div>
      <a href="/en/visa-dtv/verification-dossier/" class="btn-secondary">Discover the document check</a>
    </div>
  </section>

  <!-- Déroulé détaillé -->
  <section class="section border-t border-sable-light">
    <p class="eyebrow mb-3">Process</p>
    <h2 class="max-w-xl font-display text-3xl text-indigo">How the support process works</h2>

    <div class="mt-8 max-w-2xl">
      <StepCard number="01" title="Eligibility diagnostic" duration="1 to 2 days">
        You fill in the intake form. We analyse it and get back to you with an initial,
        reasoned view of your situation, before any payment.
      </StepCard>
      <StepCard number="02" title="Preparing the file" duration="1 to 3 weeks">
        Your advisor sends you the precise list of documents, then reviews, organises and
        checks each one as it comes in.
      </StepCard>
      <StepCard number="03" title="Your approval" duration="1 to 2 days">
        We show you the complete file. You review it and give us your go-ahead to submit
        it.
      </StepCard>
      <StepCard number="04" title="Filed by us" duration="As soon as you approve">
        We submit the application on the official e-Visa portal and pay the official visa
        fees. You're notified as soon as it's done.
      </StepCard>
      <StepCard number="05" title="Follow-up until the decision" duration="Depending on the embassy's timelines">
        We follow the application, answer requests for additional documents and keep you
        informed until the Thai authorities' decision.
      </StepCard>
    </div>
  </section>

  <!-- FAQ produit -->
  <section class="section border-t border-sable-light bg-jade-bg">
    <p class="eyebrow mb-3">Questions about the offer</p>
    <h2 class="mb-8 max-w-xl font-display text-3xl text-indigo">Before you start</h2>

    <div class="max-w-2xl">
      <FaqItem question="Do I have to pay the €699 before the diagnostic?">
        No. The initial diagnostic, based on your intake form, is free and without
        obligation. Payment only happens once you agree to start building your file.
      </FaqItem>
      <FaqItem question="What happens if my application is refused?">
        We review the reasons for the decision with you and look at the options available.
        The terms of any further support are communicated clearly on a case-by-case basis.
      </FaqItem>
      <FaqItem question="Can I pay in instalments?">
        A payment plan may be offered depending on the stage of the process. This is
        discussed with your advisor during your first conversation.
      </FaqItem>
      <FaqItem question="How does payment of the €699 work?">
        Payment happens after the free diagnostic, once you have agreed to start building
        your file. It can be made online, by card.
      </FaqItem>
      <FaqItem question="Are the official visa fees included in the €699?">
        Yes, the official visa fees applicable to your application are included in the
        package, within the terms specified when you order. Sworn translation or document
        legalisation fees remain your responsibility.
      </FaqItem>
      <FaqItem question="Can I cancel during the process?">
        Yes, you remain free to do so at any time. The terms of any cancellation during the
        process are specified before payment, so you can commit with full knowledge.
      </FaqItem>
      <FaqItem question="Who files the application and deals with the embassy?">
        We do. We submit your application on the official e-Visa portal and answer the embassy's
        requests made through that portal, such as additional documents. The only thing we can't
        do for you is appear in person if the embassy asks to see you. In that case, we prepare
        you for the appointment.
      </FaqItem>
    </div>
  </section>

  <!-- Réservation appel (Cal.com intégré) -->
  <CalInline lang="en" />

  <!-- CTA final -->
  <section class="border-t border-sable-light bg-indigo text-papier">
    <div class="section text-center">
      <h2 class="mx-auto max-w-xl font-display text-3xl text-papier">
        Ready to hand your file over to a dedicated advisor?
      </h2>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/en/fiche-renseignement/" class="btn-primary inline-flex">Start my application</a>
        <a
          href="https://buy.stripe.com/aFafZiaUU6iC9LlfQc14402"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-on-dark inline-flex"
        >
          Pay now (€699)
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
