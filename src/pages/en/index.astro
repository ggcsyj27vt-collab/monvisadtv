---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CheckItem from '../../components/CheckItem.astro';
import FaqItem from '../../components/FaqItem.astro';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is the visa guaranteed if I use MyVisaDTV?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. The final decision rests exclusively with the Thai authorities. Our role is to maximise the quality and compliance of your file, not to guarantee a decision that is not ours to make.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I submit my application myself after the diagnostic?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The initial eligibility diagnostic can be done independently of the full package. We make this clear before any commitment.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long does the support process take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'It depends on the availability of your supporting documents and consular processing times, which vary by filing location. Full details are on the package page.',
      },
    },
    {
      '@type': 'Question',
      name: 'What documents do I need to prepare before starting?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'It depends on your situation: the required documents vary depending on whether you are a remote employee, self-employed, married to a Thai national, or in another situation. The eligibility diagnostic gives you the precise list that applies to you, before any commitment.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I start this process before leaving my home country?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Most of the file preparation — diagnostic, gathering documents, verification — can be done remotely, wherever you are. Only certain filing steps depend on your place of residence at the time of the application.',
      },
    },
    {
      '@type': 'Question',
      name: 'What happens if my professional situation changes during the process?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We adapt the file to your actual situation at the time of filing. If something changes during the process (new client, new contract, change of status), tell your advisor as soon as possible so we can adjust the required documents.',
      },
    },
  ],
};
---

<BaseLayout
  title="DTV Thailand Visa Support"
  description="MyVisaDTV prepares and files your Destination Thailand Visa application with a dedicated advisor, from eligibility diagnostic to the consular decision."
  structuredData={faqSchema}
  lang="en"
  translated
>
  <!-- Hero -->
  <section class="border-b border-sable-light bg-papier">
    <div class="mx-auto grid max-w-content gap-12 px-6 py-20 md:grid-cols-[1.1fr_0.9fr] md:items-center md:px-10 md:py-28">
      <div>
        <p class="eyebrow mb-5">Destination Thailand Visa (DTV)</p>
        <h1 class="font-display text-4xl leading-tight text-indigo md:text-5xl">
          Your move to Thailand starts with a solid file.
        </h1>
        <p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-encre/80">
          MyVisaDTV prepares and files your DTV application with a dedicated advisor: from
          the eligibility diagnostic to building the file, through to the Thai authorities'
          decision.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="/en/fiche-renseignement/" class="btn-primary">Start my application</a>
          <a href="/en/visa-dtv/demande-accompagnee/" class="btn-secondary">See the €700 package</a>
        </div>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <p class="inline-flex items-center gap-2 rounded-sm bg-jade-bg px-3 py-1.5 font-mono text-xs text-jade">
            <span aria-hidden="true">●</span>
            First response within 48 business hours
          </p>
        </div>
        <p class="mt-4 font-mono text-xs text-sable">
          Independent consulting practice — not a Thai government body.
        </p>
      </div>

      <div class="rounded-lg border border-sable-light bg-white/60 p-8">
        <p class="eyebrow mb-4">What the support covers</p>
        <ul class="space-y-4">
          <CheckItem>Personalised eligibility diagnostic before any commitment</CheckItem>
          <CheckItem>List of supporting documents tailored to your situation</CheckItem>
          <CheckItem>Full review and formatting of your file</CheckItem>
          <CheckItem>A dedicated advisor available until the decision</CheckItem>
        </ul>
      </div>
    </div>
  </section>

  <!-- Pourquoi un accompagnement -->
  <section class="section">
    <p class="eyebrow mb-3">Why not file on your own</p>
    <h2 class="max-w-2xl font-display text-3xl text-indigo">
      The DTV is accessible on your own. The difficulty lies elsewhere.
    </h2>
    <div class="mt-12 grid gap-10 md:grid-cols-3">
      <div>
        <h3 class="font-display text-xl text-indigo">Criteria that keep changing</h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          Categories, amounts, durations and required documents are regularly reviewed by
          the Thai authorities. We track these changes for your file.
        </p>
      </div>
      <div>
        <h3 class="font-display text-xl text-indigo">A file that reads at a glance</h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          A poorly organised or incomplete file slows down processing. We structure every
          document to match exactly what is being asked for.
        </p>
      </div>
      <div>
        <h3 class="font-display text-xl text-indigo">A person, not a form</h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          You stay in control of your project. We answer your questions as they come up,
          right through to the decision.
        </p>
      </div>
    </div>
  </section>

  <!-- Comment ça marche (aperçu) -->
  <section class="section border-t border-sable-light">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow mb-3">How it works</p>
        <h2 class="max-w-xl font-display text-3xl text-indigo">Five steps, one file to prepare.</h2>
      </div>
      <a href="/en/visa-dtv/comprendre-le-dtv/" class="btn-secondary">Understand the DTV in detail</a>
    </div>

    <ol class="mt-12 grid gap-8 md:grid-cols-5">
      {[
        ['01', 'Diagnostic'],
        ['02', 'Building the file'],
        ['03', 'Review'],
        ['04', 'Filing the application'],
        ['05', 'Follow-up to decision'],
      ].map(([n, label]) => (
        <li>
          <span class="font-display text-2xl text-or-dark">{n}</span>
          <p class="mt-2 font-sans text-sm font-medium text-indigo">{label}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Offre -->
  <section class="border-y border-sable-light bg-indigo text-papier">
    <div class="section flex flex-wrap items-center justify-between gap-10">
      <div class="max-w-xl">
        <p class="eyebrow mb-3">The full package</p>
        <h2 class="font-display text-3xl text-papier md:text-4xl">€700 instead of €1,000 for a file handled from start to finish</h2>
        <p class="mt-4 font-sans text-sm leading-relaxed text-papier/75">
          Official visa fees included, for the entire process: from diagnostic to decision.
        </p>
      </div>
      <a href="/en/visa-dtv/demande-accompagnee/" class="btn-primary">See the full offer</a>
    </div>
  </section>

  <!-- FAQ courte -->
  <section class="section">
    <p class="eyebrow mb-3">Frequently asked questions</p>
    <h2 class="mb-8 max-w-xl font-display text-3xl text-indigo">Before you get started</h2>

    <div class="max-w-2xl">
      <FaqItem question="Is the visa guaranteed if I use MyVisaDTV?">
        No. The final decision rests exclusively with the Thai authorities. Our role is to
        maximise the quality and compliance of your file, not to guarantee a decision that
        is not ours to make.
      </FaqItem>
      <FaqItem question="Can I submit my application myself after the diagnostic?">
        Yes. The initial eligibility diagnostic can be done independently of the full
        package. We make this clear before any commitment.
      </FaqItem>
      <FaqItem question="How long does the support process take?">
        It depends on the availability of your supporting documents and consular processing
        times, which vary by filing location. Full details are on the package page.
      </FaqItem>
      <FaqItem question="What documents do I need to prepare before starting?">
        It depends on your situation: the required documents vary depending on whether you
        are a remote employee, self-employed, married to a Thai national, or in another
        situation. The eligibility diagnostic gives you the precise list that applies to
        you, before any commitment.
      </FaqItem>
      <FaqItem question="Can I start this process before leaving my home country?">
        Yes. Most of the file preparation — diagnostic, gathering documents, verification —
        can be done remotely, wherever you are. Only certain filing steps depend on your
        place of residence at the time of the application.
      </FaqItem>
      <FaqItem question="What happens if my professional situation changes during the process?">
        We adapt the file to your actual situation at the time of filing. If something
        changes during the process (new client, new contract, change of status), tell your
        advisor as soon as possible so we can adjust the required documents.
      </FaqItem>
    </div>
  </section>

  <!-- Contact direct WhatsApp -->
  <section class="section border-t border-sable-light">
    <div class="mx-auto flex max-w-2xl flex-col items-center rounded-lg border border-sable-light bg-white px-8 py-12 text-center shadow-sm">
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-jade-bg">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-7 w-7 text-jade" aria-hidden="true">
          <path
            d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M8.7 8.6c.2-.5.5-.5.7-.5h.5c.2 0 .4 0 .6.4.2.5.6 1.4.7 1.5.1.1.1.3 0 .4-.1.2-.2.3-.3.4-.1.1-.3.3-.4.4-.1.1-.3.3-.1.6.2.3.8 1.2 1.6 1.9 1.1 1 2 1.3 2.3 1.4.3.1.5.1.6-.1.2-.2.6-.7.8-.9.2-.2.3-.2.6-.1.2.1 1.4.7 1.7.8.3.1.4.2.5.3.1.2.1.9-.2 1.3-.3.4-1.2.9-1.7.9-.5 0-1 .1-3.2-.9-2.7-1.2-4.4-4-4.5-4.2-.1-.2-1-1.4-1-2.6 0-1.2.6-1.8.8-2Z"
            fill="currentColor"
          />
        </svg>
      </span>
      <p class="eyebrow mt-6">A question before you get started?</p>
      <h2 class="mt-3 max-w-md font-display text-2xl text-indigo md:text-3xl">
        Let's talk about your situation directly
      </h2>
      <p class="mt-4 max-w-md font-sans text-sm leading-relaxed text-encre/75">
        No need to fill in a form to ask a first question. Message us on WhatsApp — an
        advisor will get back to you, no strings attached.
      </p>
      <a
        href="https://wa.me/66631747492?text=Hello%2C%20I%20have%20a%20question%20about%20the%20DTV%20visa."
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary mt-7 inline-flex"
      >
        Message us on WhatsApp
      </a>
    </div>
  </section>

  <!-- CTA final -->
  <section class="border-t border-sable-light bg-jade-bg">
    <div class="section text-center">
      <h2 class="mx-auto max-w-xl font-display text-3xl text-indigo">
        Start with a five-minute intake form.
      </h2>
      <p class="mx-auto mt-4 max-w-md font-sans text-sm text-encre/80">
        We'll get back to you with an initial view on your eligibility, no strings attached.
      </p>
      <a href="/en/fiche-renseignement/" class="btn-primary mt-8 inline-flex">Fill in the intake form</a>
    </div>
  </section>
</BaseLayout>
