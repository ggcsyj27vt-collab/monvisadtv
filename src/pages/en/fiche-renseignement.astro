---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Intake form"
  description="Answer a few questions to get a free, no-obligation initial view on your DTV visa eligibility."
  lang="en"
  translated
>
  <section class="border-b border-sable-light bg-papier">
    <div class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
      <p class="eyebrow mb-4">Step 1 — no obligation</p>
      <h1 class="max-w-2xl font-display text-4xl leading-tight text-indigo md:text-5xl">
        Tell us about your project
      </h1>
      <p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-encre/80">
        Five minutes is all it takes. Your advisor will get back to you with an initial
        view on your eligibility, before any payment.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="grid gap-14 md:grid-cols-[1fr_0.7fr]">
      <form
        method="POST"
        action="https://formspree.io/f/mgaegdgv"
        class="space-y-8"
        id="fiche-form"
        novalidate
      >
        <!-- Barre de progression -->
        <div class="space-y-2">
          <div class="flex items-center justify-between font-sans text-xs font-medium text-encre/70">
            <span id="step-label">Step 1 of 3 — Your details</span>
            <span id="step-count">1/3</span>
          </div>
          <div class="h-1.5 w-full overflow-hidden rounded-full bg-sable-light">
            <div
              id="progress-bar"
              class="h-full rounded-full bg-jade transition-all duration-300 ease-out"
              style="width: 33.3333%"
            ></div>
          </div>
        </div>

        <fieldset class="form-step space-y-5" data-step="1">
          <legend class="font-display text-xl text-indigo">Your details</legend>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="prenom" class="block font-sans text-sm font-medium text-encre">First name</label>
              <input
                type="text" id="prenom" name="prenom" required autocomplete="given-name"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
            <div>
              <label for="nom" class="block font-sans text-sm font-medium text-encre">Last name</label>
              <input
                type="text" id="nom" name="nom" required autocomplete="family-name"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="email" class="block font-sans text-sm font-medium text-encre">Email</label>
              <input
                type="email" id="email" name="email" required autocomplete="email"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
            <div>
              <label for="telephone" class="block font-sans text-sm font-medium text-encre">Phone (with country code)</label>
              <input
                type="tel" id="telephone" name="telephone" autocomplete="tel"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="pays" class="block font-sans text-sm font-medium text-encre">Current country of residence</label>
            <input
              type="text" id="pays" name="pays" required
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            />
          </div>
        </fieldset>

        <fieldset class="form-step space-y-5" data-step="2" hidden>
          <legend class="font-display text-xl text-indigo">Your situation</legend>

          <div>
            <label for="statut" class="block font-sans text-sm font-medium text-encre">Which situation best describes you?</label>
            <select
              id="statut" name="statut" required
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            >
              <option value="">Select an option</option>
              <option value="teletravailleur">Remote employee working abroad</option>
              <option value="independant">Self-employed / freelancer</option>
              <option value="conjoint">Spouse of a Thai national</option>
              <option value="activite-encadree">Supervised training, internship, or cultural/sporting activity</option>
              <option value="autre">Other situation</option>
            </select>
          </div>

          <div>
            <label for="activite" class="block font-sans text-sm font-medium text-encre">Briefly describe your professional activity</label>
            <textarea
              id="activite" name="activite" rows="3" required
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            ></textarea>
          </div>

          <div>
            <label for="revenu" class="block font-sans text-sm font-medium text-encre">Approximate monthly income range</label>
            <select
              id="revenu" name="revenu"
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            >
              <option value="">Prefer not to say for now</option>
              <option value="moins-2000">Less than €2,000</option>
              <option value="2000-4000">Between €2,000 and €4,000</option>
              <option value="4000-6000">Between €4,000 and €6,000</option>
              <option value="plus-6000">More than €6,000</option>
            </select>
          </div>
        </fieldset>

        <fieldset class="form-step space-y-5" data-step="3" hidden>
          <legend class="font-display text-xl text-indigo">Your project</legend>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="depart" class="block font-sans text-sm font-medium text-encre">Planned departure</label>
              <input
                type="month" id="depart" name="depart"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
            <div>
              <label for="duree" class="block font-sans text-sm font-medium text-encre">Planned length of stay</label>
              <select
                id="duree" name="duree"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              >
                <option value="">Select an option</option>
                <option value="moins-6-mois">Less than 6 months</option>
                <option value="6-12-mois">6 to 12 months</option>
                <option value="plus-1-an">More than a year</option>
                <option value="indetermine">Not yet decided</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block font-sans text-sm font-medium text-encre">Additional information (optional)</label>
            <textarea
              id="message" name="message" rows="4"
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            ></textarea>
          </div>
        </fieldset>

        <div class="form-step space-y-6" data-step="3-extra" hidden>
          <div class="flex items-start gap-3">
            <input type="checkbox" id="rgpd" name="rgpd" required class="mt-1 h-4 w-4 border-sable-light" />
            <label for="rgpd" class="font-sans text-xs leading-relaxed text-encre/80">
              I agree that the information submitted through this form may be used by
              MyVisaDTV to assess my eligibility and contact me. See our
              <a href="/en/confidentialite/" class="underline hover:text-indigo">privacy policy</a>.
            </label>
          </div>
        </div>

        <!-- Navigation entre étapes -->
        <div class="flex items-center justify-between pt-2">
          <button
            type="button"
            id="btn-prev"
            class="font-sans text-sm font-medium text-encre/70 underline decoration-sable-light underline-offset-4 hover:text-indigo"
            hidden
          >
            ← Previous step
          </button>
          <div class="ml-auto flex gap-3">
            <button type="button" id="btn-next" class="btn-primary">
              Next step →
            </button>
            <button type="submit" id="btn-submit" class="btn-primary" hidden>
              Send my intake form
            </button>
          </div>
        </div>
      </form>

      <script>
        const form = document.getElementById('fiche-form') as HTMLFormElement;
        const steps = Array.from(form.querySelectorAll<HTMLElement>('.form-step'));
        const stepGroups = [
          [steps[0]],
          [steps[1]],
          [steps[2], steps[3]],
        ];
        const totalSteps = stepGroups.length;
        let current = 0;

        const stepLabel = document.getElementById('step-label')!;
        const stepCount = document.getElementById('step-count')!;
        const progressBar = document.getElementById('progress-bar')!;
        const btnPrev = document.getElementById('btn-prev') as HTMLButtonElement;
        const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
        const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;

        const labels = ['Your details', 'Your situation', 'Your project'];

        function render() {
          stepGroups.forEach((group, i) => {
            group.forEach((el) => {
              el.hidden = i !== current;
            });
          });

          stepLabel.textContent = `Step ${current + 1} of ${totalSteps} — ${labels[current]}`;
          stepCount.textContent = `${current + 1}/${totalSteps}`;
          progressBar.style.width = `${((current + 1) / totalSteps) * 100}%`;

          btnPrev.hidden = current === 0;
          btnNext.hidden = current === totalSteps - 1;
          btnSubmit.hidden = current !== totalSteps - 1;
        }

        function currentStepIsValid(): boolean {
          const group = stepGroups[current];
          let valid = true;
          group.forEach((el) => {
            el.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea').forEach((field) => {
              if (!field.checkValidity()) {
                valid = false;
                field.reportValidity();
              }
            });
          });
          return valid;
        }

        btnNext.addEventListener('click', () => {
          if (!currentStepIsValid()) return;
          if (current < totalSteps - 1) {
            current += 1;
            render();
            form.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });

        btnPrev.addEventListener('click', () => {
          if (current > 0) {
            current -= 1;
            render();
            form.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });

        form.addEventListener('submit', (e) => {
          if (!currentStepIsValid()) {
            e.preventDefault();
            return;
          }
          steps.forEach((step) => {
            step.hidden = false;
          });
        });

        render();
      </script>

      <aside class="h-fit space-y-6">
        <div class="rounded-lg border border-sable-light bg-jade-bg p-8">
          <h2 class="font-display text-lg text-indigo">What happens next</h2>
          <ol class="mt-5 space-y-4 font-sans text-sm leading-relaxed text-encre/80">
            <li><span class="font-mono text-xs text-jade">01</span> — An advisor reviews your situation within 48 business hours.</li>
            <li><span class="font-mono text-xs text-jade">02</span> — You receive an initial view on your eligibility, free and with no obligation.</li>
            <li><span class="font-mono text-xs text-jade">03</span> — If you'd like to go ahead, we walk you through the €700 package in detail.</li>
          </ol>
        </div>

        <div class="rounded-lg border border-sable-light bg-white p-8">
          <h2 class="font-display text-lg text-indigo">Prefer to talk directly?</h2>
          <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
            Scan this QR code to message us on WhatsApp — handy if you're already in
            Thailand or would rather ask your questions before filling in the form.
          </p>
          <img
            src="/images/whatsapp-qr.jpg"
            alt="QR code to contact MyVisaDTV on WhatsApp"
            class="mx-auto mt-5 h-36 w-36 rounded-md border border-sable-light"
            width="602"
            height="602"
          />
          <a
            href="https://wa.me/66631747492?text=Hello%2C%20I%27d%20like%20to%20know%20more%20about%20the%20DTV%20visa%20support."
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 block text-center font-sans text-sm font-semibold text-jade hover:text-jade-light"
          >
            Or tap here on mobile →
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
