---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kontaktformular"
  description="Beantworten Sie einige Fragen, um eine kostenlose, unverbindliche erste Einschätzung Ihrer DTV-Visum-Eignung zu erhalten."
  lang="de"
  translated
>
  <section class="border-b border-sable-light bg-papier">
    <div class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
      <p class="eyebrow mb-4">Schritt 1 — unverbindlich</p>
      <h1 class="max-w-2xl font-display text-4xl leading-tight text-indigo md:text-5xl">
        Erzählen Sie uns von Ihrem Projekt
      </h1>
      <p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-encre/80">
        Fünf Minuten genügen. Ihr Berater meldet sich mit einer ersten Einschätzung zu Ihrer
        Eignung, vor jeder Zahlung.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="grid gap-14 md:grid-cols-[1fr_0.7fr]">
      <form
        method="POST"
        action="https://formspree.io/f/mgaegdgv"
        class="space-y-8"
        id="fiche-form"
        novalidate
      >
        <!-- Barre de progression -->
        <div class="space-y-2">
          <div class="flex items-center justify-between font-sans text-xs font-medium text-encre/70">
            <span id="step-label">Schritt 1 von 3 — Ihre Kontaktdaten</span>
            <span id="step-count">1/3</span>
          </div>
          <div class="h-1.5 w-full overflow-hidden rounded-full bg-sable-light">
            <div
              id="progress-bar"
              class="h-full rounded-full bg-jade transition-all duration-300 ease-out"
              style="width: 33.3333%"
            ></div>
          </div>
        </div>

        <fieldset class="form-step space-y-5" data-step="1">
          <legend class="font-display text-xl text-indigo">Ihre Kontaktdaten</legend>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="prenom" class="block font-sans text-sm font-medium text-encre">Vorname</label>
              <input
                type="text" id="prenom" name="prenom" required autocomplete="given-name"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
            <div>
              <label for="nom" class="block font-sans text-sm font-medium text-encre">Nachname</label>
              <input
                type="text" id="nom" name="nom" required autocomplete="family-name"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="email" class="block font-sans text-sm font-medium text-encre">E-Mail</label>
              <input
                type="email" id="email" name="email" required autocomplete="email"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
            <div>
              <label for="telephone" class="block font-sans text-sm font-medium text-encre">Telefon (mit Ländervorwahl)</label>
              <input
                type="tel" id="telephone" name="telephone" autocomplete="tel"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="pays" class="block font-sans text-sm font-medium text-encre">Aktuelles Wohnsitzland</label>
            <input
              type="text" id="pays" name="pays" required
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            />
          </div>
        </fieldset>

        <fieldset class="form-step space-y-5" data-step="2" hidden>
          <legend class="font-display text-xl text-indigo">Ihre Situation</legend>

          <div>
            <label for="statut" class="block font-sans text-sm font-medium text-encre">Welche Situation trifft am besten auf Sie zu?</label>
            <select
              id="statut" name="statut" required
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            >
              <option value="">Bitte auswählen</option>
              <option value="teletravailleur">Angestellt im Homeoffice im Ausland</option>
              <option value="independant">Selbstständig / Freiberufler</option>
              <option value="conjoint">Ehepartner/-in eines thailändischen Staatsangehörigen</option>
              <option value="activite-encadree">Ausbildung, Praktikum oder begleitete kulturelle/sportliche Aktivität</option>
              <option value="autre">Andere Situation</option>
            </select>
          </div>

          <div>
            <label for="activite" class="block font-sans text-sm font-medium text-encre">Beschreiben Sie kurz Ihre berufliche Tätigkeit</label>
            <textarea
              id="activite" name="activite" rows="3" required
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            ></textarea>
          </div>

          <div>
            <label for="revenu" class="block font-sans text-sm font-medium text-encre">Ungefähre monatliche Einkommensspanne</label>
            <select
              id="revenu" name="revenu"
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            >
              <option value="">Möchte ich vorerst nicht angeben</option>
              <option value="moins-2000">Weniger als 2.000 €</option>
              <option value="2000-4000">Zwischen 2.000 € und 4.000 €</option>
              <option value="4000-6000">Zwischen 4.000 € und 6.000 €</option>
              <option value="plus-6000">Mehr als 6.000 €</option>
            </select>
          </div>
        </fieldset>

        <fieldset class="form-step space-y-5" data-step="3" hidden>
          <legend class="font-display text-xl text-indigo">Ihr Projekt</legend>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="depart" class="block font-sans text-sm font-medium text-encre">Geplante Abreise</label>
              <input
                type="month" id="depart" name="depart"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              />
            </div>
            <div>
              <label for="duree" class="block font-sans text-sm font-medium text-encre">Geplante Aufenthaltsdauer</label>
              <select
                id="duree" name="duree"
                class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
              >
                <option value="">Bitte auswählen</option>
                <option value="moins-6-mois">Weniger als 6 Monate</option>
                <option value="6-12-mois">6 bis 12 Monate</option>
                <option value="plus-1-an">Mehr als ein Jahr</option>
                <option value="indetermine">Noch unbestimmt</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block font-sans text-sm font-medium text-encre">Zusätzliche Informationen (optional)</label>
            <textarea
              id="message" name="message" rows="4"
              class="mt-2 w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
            ></textarea>
          </div>
        </fieldset>

        <div class="form-step space-y-6" data-step="3-extra" hidden>
          <div class="flex items-start gap-3">
            <input type="checkbox" id="rgpd" name="rgpd" required class="mt-1 h-4 w-4 border-sable-light" />
            <label for="rgpd" class="font-sans text-xs leading-relaxed text-encre/80">
              Ich stimme zu, dass die über dieses Formular übermittelten Informationen von
              MyVisaDTV verwendet werden, um meine Eignung zu prüfen und mich zu
              kontaktieren. Siehe unsere
              <a href="/de/confidentialite/" class="underline hover:text-indigo">Datenschutzerklärung</a>.
            </label>
          </div>
        </div>

        <!-- Navigation entre étapes -->
        <div class="flex items-center justify-between pt-2">
          <button
            type="button"
            id="btn-prev"
            class="font-sans text-sm font-medium text-encre/70 underline decoration-sable-light underline-offset-4 hover:text-indigo"
            hidden
          >
            ← Vorheriger Schritt
          </button>
          <div class="ml-auto flex gap-3">
            <button type="button" id="btn-next" class="btn-primary">
              Nächster Schritt →
            </button>
            <button type="submit" id="btn-submit" class="btn-primary" hidden>
              Formular absenden
            </button>
          </div>
        </div>
      </form>

      <script>
        const form = document.getElementById('fiche-form') as HTMLFormElement;
        const steps = Array.from(form.querySelectorAll<HTMLElement>('.form-step'));
        const stepGroups = [
          [steps[0]],
          [steps[1]],
          [steps[2], steps[3]],
        ];
        const totalSteps = stepGroups.length;
        let current = 0;

        const stepLabel = document.getElementById('step-label')!;
        const stepCount = document.getElementById('step-count')!;
        const progressBar = document.getElementById('progress-bar')!;
        const btnPrev = document.getElementById('btn-prev') as HTMLButtonElement;
        const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
        const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;

        const labels = ['Ihre Kontaktdaten', 'Ihre Situation', 'Ihr Projekt'];

        function render() {
          stepGroups.forEach((group, i) => {
            group.forEach((el) => {
              el.hidden = i !== current;
            });
          });

          stepLabel.textContent = `Schritt ${current + 1} von ${totalSteps} — ${labels[current]}`;
          stepCount.textContent = `${current + 1}/${totalSteps}`;
          progressBar.style.width = `${((current + 1) / totalSteps) * 100}%`;

          btnPrev.hidden = current === 0;
          btnNext.hidden = current === totalSteps - 1;
          btnSubmit.hidden = current !== totalSteps - 1;
        }

        function currentStepIsValid(): boolean {
          const group = stepGroups[current];
          let valid = true;
          group.forEach((el) => {
            el.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea').forEach((field) => {
              if (!field.checkValidity()) {
                valid = false;
                field.reportValidity();
              }
            });
          });
          return valid;
        }

        btnNext.addEventListener('click', () => {
          if (!currentStepIsValid()) return;
          if (current < totalSteps - 1) {
            current += 1;
            render();
            form.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });

        btnPrev.addEventListener('click', () => {
          if (current > 0) {
            current -= 1;
            render();
            form.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });

        form.addEventListener('submit', (e) => {
          if (!currentStepIsValid()) {
            e.preventDefault();
            return;
          }
          steps.forEach((step) => {
            step.hidden = false;
          });
        });

        render();
      </script>

      <aside class="h-fit space-y-6">
        <div class="rounded-lg border border-sable-light bg-jade-bg p-8">
          <h2 class="font-display text-lg text-indigo">Wie es weitergeht</h2>
          <ol class="mt-5 space-y-4 font-sans text-sm leading-relaxed text-encre/80">
            <li><span class="font-mono text-xs text-jade">01</span> — Ein Berater prüft Ihre Situation innerhalb von 48 Werkstunden.</li>
            <li><span class="font-mono text-xs text-jade">02</span> — Sie erhalten eine erste Einschätzung zu Ihrer Eignung, kostenlos und unverbindlich.</li>
            <li><span class="font-mono text-xs text-jade">03</span> — Wenn Sie fortfahren möchten, stellen wir Ihnen das 700-€-Paket im Detail vor.</li>
          </ol>
        </div>

        <div class="rounded-lg border border-sable-light bg-white p-8">
          <h2 class="font-display text-lg text-indigo">Lieber direkt sprechen?</h2>
          <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
            Scannen Sie diesen QR-Code, um uns auf WhatsApp zu schreiben — praktisch, wenn
            Sie sich bereits in Thailand befinden oder Ihre Fragen lieber vor dem Ausfüllen
            des Formulars stellen möchten.
          </p>
          <img
            src="/images/whatsapp-qr.jpg"
            alt="QR-Code zur Kontaktaufnahme mit MyVisaDTV auf WhatsApp"
            class="mx-auto mt-5 h-36 w-36 rounded-md border border-sable-light"
            width="602"
            height="602"
          />
          <a
            href="https://wa.me/66631747492?text=Hallo%2C%20ich%20h%C3%A4tte%20gerne%20mehr%20Informationen%20zur%20Begleitung%20beim%20DTV-Visum."
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 block text-center font-sans text-sm font-semibold text-jade hover:text-jade-light"
          >
            Oder hier auf dem Handy tippen →
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
