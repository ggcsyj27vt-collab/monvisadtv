---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CheckItem from '../../components/CheckItem.astro';
import FaqItem from '../../components/FaqItem.astro';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Ist das Visum garantiert, wenn ich MyVisaDTV nutze?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nein. Die endgültige Entscheidung liegt ausschließlich bei den thailändischen Behörden. Unsere Aufgabe ist es, die Qualität und Vollständigkeit Ihrer Unterlagen zu maximieren, nicht eine Entscheidung zu garantieren, die nicht in unserer Hand liegt.',
      },
    },
    {
      '@type': 'Question',
      name: 'Kann ich meinen Antrag nach der Diagnose selbst einreichen?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ja. Die anfängliche Eignungsprüfung kann unabhängig vom Komplettpaket durchgeführt werden. Wir weisen Sie vor jeder Verpflichtung klar darauf hin.',
      },
    },
    {
      '@type': 'Question',
      name: 'Wie lange dauert die Begleitung?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Das hängt von der Verfügbarkeit Ihrer Unterlagen und den konsularischen Bearbeitungszeiten ab, die je nach Einreichungsort variieren. Details finden Sie auf der Seite zum Komplettpaket.',
      },
    },
    {
      '@type': 'Question',
      name: 'Welche Unterlagen muss ich vor dem Start vorbereiten?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Das hängt von Ihrer Situation ab: Die erforderlichen Unterlagen variieren je nachdem, ob Sie im Homeoffice angestellt, selbstständig, mit einer thailändischen Staatsangehörigen verheiratet oder in einer anderen Situation sind. Die Eignungsprüfung nennt Ihnen die genaue Liste, die auf Sie zutrifft, vor jeder Verpflichtung.',
      },
    },
    {
      '@type': 'Question',
      name: 'Kann ich diesen Prozess schon vor meiner Abreise beginnen?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ja. Der größte Teil der Vorbereitung — Diagnose, Zusammenstellung der Unterlagen, Prüfung — kann aus der Ferne erfolgen, egal wo Sie sich befinden. Nur bestimmte Schritte der Einreichung hängen von Ihrem Wohnort zum Zeitpunkt des Antrags ab.',
      },
    },
    {
      '@type': 'Question',
      name: 'Was passiert, wenn sich meine berufliche Situation während des Verfahrens ändert?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Wir passen die Unterlagen an Ihre tatsächliche Situation zum Zeitpunkt der Einreichung an. Wenn sich während der Begleitung etwas ändert (neuer Kunde, neuer Vertrag, Statuswechsel), informieren Sie Ihren Berater so schnell wie möglich, damit wir die erforderlichen Unterlagen anpassen können.',
      },
    },
  ],
};
---

<BaseLayout
  title="Unterstützung beim DTV-Visum Thailand"
  description="MyVisaDTV bereitet Ihren Antrag für das Destination Thailand Visa mit einem persönlichen Berater vor und reicht ihn ein — von der Eignungsprüfung bis zur konsularischen Entscheidung."
  structuredData={faqSchema}
  lang="de"
  translated
>
  <!-- Hero -->
  <section class="border-b border-sable-light bg-papier">
    <div class="mx-auto grid max-w-content gap-12 px-6 py-20 md:grid-cols-[1.1fr_0.9fr] md:items-center md:px-10 md:py-28">
      <div>
        <p class="eyebrow mb-5">Destination Thailand Visa (DTV)</p>
        <h1 class="font-display text-4xl leading-tight text-indigo md:text-5xl">
          Ihr Neustart in Thailand beginnt mit soliden Unterlagen.
        </h1>
        <p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-encre/80">
          MyVisaDTV bereitet Ihren DTV-Antrag mit einem persönlichen Berater vor und reicht
          ihn ein: von der Eignungsprüfung über die Zusammenstellung der Unterlagen bis zur
          Entscheidung der thailändischen Behörden.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="/de/fiche-renseignement/" class="btn-primary">Antrag jetzt starten</a>
          <a href="/de/visa-dtv/demande-accompagnee/" class="btn-secondary">Das 700-€-Paket ansehen</a>
        </div>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <p class="inline-flex items-center gap-2 rounded-sm bg-jade-bg px-3 py-1.5 font-mono text-xs text-jade">
            <span aria-hidden="true">●</span>
            Erste Rückmeldung innerhalb von 48 Werkstunden
          </p>
        </div>
        <p class="mt-4 font-mono text-xs text-sable">
          Unabhängige Beratungsstelle — keine thailändische Behörde.
        </p>
      </div>

      <div class="rounded-lg border border-sable-light bg-white/60 p-8">
        <p class="eyebrow mb-4">Das umfasst die Begleitung</p>
        <ul class="space-y-4">
          <CheckItem>Individuelle Eignungsprüfung vor jeder Verpflichtung</CheckItem>
          <CheckItem>Liste der Unterlagen, angepasst an Ihre Situation</CheckItem>
          <CheckItem>Vollständige Prüfung und Aufbereitung der Unterlagen</CheckItem>
          <CheckItem>Ein persönlicher Berater bis zur Entscheidung erreichbar</CheckItem>
        </ul>
      </div>
    </div>
  </section>

  <!-- Pourquoi un accompagnement -->
  <section class="section">
    <p class="eyebrow mb-3">Warum nicht alleine einreichen</p>
    <h2 class="max-w-2xl font-display text-3xl text-indigo">
      Das DTV ist auch im Alleingang zugänglich. Die Schwierigkeit liegt woanders.
    </h2>
    <div class="mt-12 grid gap-10 md:grid-cols-3">
      <div>
        <h3 class="font-display text-xl text-indigo">Kriterien, die sich ändern</h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          Kategorien, Beträge, Laufzeiten und geforderte Unterlagen werden regelmäßig von
          den thailändischen Behörden überprüft. Wir verfolgen diese Änderungen für Ihre
          Unterlagen.
        </p>
      </div>
      <div>
        <h3 class="font-display text-xl text-indigo">Unterlagen, die auf einen Blick verständlich sind</h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          Schlecht geordnete oder unvollständige Unterlagen verzögern die Bearbeitung. Wir
          strukturieren jedes Dokument so, dass es genau den Anforderungen entspricht.
        </p>
      </div>
      <div>
        <h3 class="font-display text-xl text-indigo">Ein Ansprechpartner, kein Formular</h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          Sie behalten die Kontrolle über Ihr Projekt. Wir beantworten Ihre Fragen laufend,
          bis zur endgültigen Entscheidung.
        </p>
      </div>
    </div>
  </section>

  <!-- Comment ça marche (aperçu) -->
  <section class="section border-t border-sable-light">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow mb-3">Der Ablauf</p>
        <h2 class="max-w-xl font-display text-3xl text-indigo">Fünf Schritte, ein einziges Dossier.</h2>
      </div>
      <a href="/de/visa-dtv/comprendre-le-dtv/" class="btn-secondary">Das DTV im Detail verstehen</a>
    </div>

    <ol class="mt-12 grid gap-8 md:grid-cols-5">
      {[
        ['01', 'Eignungsprüfung'],
        ['02', 'Zusammenstellung der Unterlagen'],
        ['03', 'Prüfung'],
        ['04', 'Einreichung des Antrags'],
        ['05', 'Begleitung bis zur Entscheidung'],
      ].map(([n, label]) => (
        <li>
          <span class="font-display text-2xl text-or-dark">{n}</span>
          <p class="mt-2 font-sans text-sm font-medium text-indigo">{label}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Offre -->
  <section class="border-y border-sable-light bg-indigo text-papier">
    <div class="section flex flex-wrap items-center justify-between gap-10">
      <div class="max-w-xl">
        <p class="eyebrow mb-3">Das Komplettpaket</p>
        <h2 class="font-display text-3xl text-papier md:text-4xl">700 € statt 1.000 € für eine Rundum-Betreuung Ihrer Unterlagen</h2>
        <p class="mt-4 font-sans text-sm leading-relaxed text-papier/75">
          Offizielle Visumgebühren inbegriffen, für die gesamte Begleitung: von der
          Eignungsprüfung bis zur Entscheidung.
        </p>
      </div>
      <a href="/de/visa-dtv/demande-accompagnee/" class="btn-primary">Angebot im Detail ansehen</a>
    </div>
  </section>

  <!-- FAQ courte -->
  <section class="section">
    <p class="eyebrow mb-3">Häufig gestellte Fragen</p>
    <h2 class="mb-8 max-w-xl font-display text-3xl text-indigo">Bevor Sie starten</h2>

    <div class="max-w-2xl">
      <FaqItem question="Ist das Visum garantiert, wenn ich MyVisaDTV nutze?">
        Nein. Die endgültige Entscheidung liegt ausschließlich bei den thailändischen
        Behörden. Unsere Aufgabe ist es, die Qualität und Vollständigkeit Ihrer Unterlagen
        zu maximieren, nicht eine Entscheidung zu garantieren, die nicht in unserer Hand
        liegt.
      </FaqItem>
      <FaqItem question="Kann ich meinen Antrag nach der Diagnose selbst einreichen?">
        Ja. Die anfängliche Eignungsprüfung kann unabhängig vom Komplettpaket durchgeführt
        werden. Wir weisen Sie vor jeder Verpflichtung klar darauf hin.
      </FaqItem>
      <FaqItem question="Wie lange dauert die Begleitung?">
        Das hängt von der Verfügbarkeit Ihrer Unterlagen und den konsularischen
        Bearbeitungszeiten ab, die je nach Einreichungsort variieren. Details finden Sie auf
        der Seite zum Komplettpaket.
      </FaqItem>
      <FaqItem question="Welche Unterlagen muss ich vor dem Start vorbereiten?">
        Das hängt von Ihrer Situation ab: Die erforderlichen Unterlagen variieren je
        nachdem, ob Sie im Homeoffice angestellt, selbstständig, mit einer thailändischen
        Staatsangehörigen verheiratet oder in einer anderen Situation sind. Die
        Eignungsprüfung nennt Ihnen die genaue Liste, die auf Sie zutrifft, vor jeder
        Verpflichtung.
      </FaqItem>
      <FaqItem question="Kann ich diesen Prozess schon vor meiner Abreise beginnen?">
        Ja. Der größte Teil der Vorbereitung — Diagnose, Zusammenstellung der Unterlagen,
        Prüfung — kann aus der Ferne erfolgen, egal wo Sie sich befinden. Nur bestimmte
        Schritte der Einreichung hängen von Ihrem Wohnort zum Zeitpunkt des Antrags ab.
      </FaqItem>
      <FaqItem question="Was passiert, wenn sich meine berufliche Situation während des Verfahrens ändert?">
        Wir passen die Unterlagen an Ihre tatsächliche Situation zum Zeitpunkt der
        Einreichung an. Wenn sich während der Begleitung etwas ändert (neuer Kunde, neuer
        Vertrag, Statuswechsel), informieren Sie Ihren Berater so schnell wie möglich, damit
        wir die erforderlichen Unterlagen anpassen können.
      </FaqItem>
    </div>
  </section>

  <!-- Contact direct WhatsApp -->
  <section class="section border-t border-sable-light">
    <div class="mx-auto flex max-w-2xl flex-col items-center rounded-lg border border-sable-light bg-white px-8 py-12 text-center shadow-sm">
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-jade-bg">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-7 w-7 text-jade" aria-hidden="true">
          <path
            d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M8.7 8.6c.2-.5.5-.5.7-.5h.5c.2 0 .4 0 .6.4.2.5.6 1.4.7 1.5.1.1.1.3 0 .4-.1.2-.2.3-.3.4-.1.1-.3.3-.4.4-.1.1-.3.3-.1.6.2.3.8 1.2 1.6 1.9 1.1 1 2 1.3 2.3 1.4.3.1.5.1.6-.1.2-.2.6-.7.8-.9.2-.2.3-.2.6-.1.2.1 1.4.7 1.7.8.3.1.4.2.5.3.1.2.1.9-.2 1.3-.3.4-1.2.9-1.7.9-.5 0-1 .1-3.2-.9-2.7-1.2-4.4-4-4.5-4.2-.1-.2-1-1.4-1-2.6 0-1.2.6-1.8.8-2Z"
            fill="currentColor"
          />
        </svg>
      </span>
      <p class="eyebrow mt-6">Eine Frage, bevor Sie starten?</p>
      <h2 class="mt-3 max-w-md font-display text-2xl text-indigo md:text-3xl">
        Sprechen wir direkt über Ihre Situation
      </h2>
      <p class="mt-4 max-w-md font-sans text-sm leading-relaxed text-encre/75">
        Sie müssen kein Formular ausfüllen, um eine erste Frage zu stellen. Schreiben Sie
        uns auf WhatsApp — ein Berater antwortet Ihnen unverbindlich.
      </p>
      <a
        href="https://wa.me/66631747492?text=Hallo%2C%20ich%20habe%20eine%20Frage%20zum%20DTV-Visum."
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary mt-7 inline-flex"
      >
        Auf WhatsApp schreiben
      </a>
    </div>
  </section>

  <!-- CTA final -->
  <section class="border-t border-sable-light bg-jade-bg">
    <div class="section text-center">
      <h2 class="mx-auto max-w-xl font-display text-3xl text-indigo">
        Beginnen Sie mit einem fünfminütigen Kontaktformular.
      </h2>
      <p class="mx-auto mt-4 max-w-md font-sans text-sm text-encre/80">
        Wir melden uns mit einer ersten Einschätzung zu Ihrer Eignung bei Ihnen, unverbindlich.
      </p>
      <a href="/de/fiche-renseignement/" class="btn-primary mt-8 inline-flex">Kontaktformular ausfüllen</a>
    </div>
  </section>
</BaseLayout>
