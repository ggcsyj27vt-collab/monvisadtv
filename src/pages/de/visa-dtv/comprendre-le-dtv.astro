---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FaqItem from '../../../components/FaqItem.astro';
import DerniereMiseAJour from '../../../components/DerniereMiseAJour.astro';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Ersetzt das DTV ein klassisches Arbeitsvisum?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nein. Es deckt andere Situationen ab, insbesondere Fernarbeit für einen ausländischen Arbeitgeber. Eine direkte Anstellung bei einem thailändischen Unternehmen fällt in der Regel unter eine andere Visumkategorie.',
      },
    },
    {
      '@type': 'Question',
      name: 'Kann ich meine Familie mit einem DTV mitbringen?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Bestimmte familiäre Situationen werden je nach den Bedingungen der jeweiligen Kategorie berücksichtigt. Wir prüfen dies gemeinsam mit Ihnen während der Diagnose.',
      },
    },
    {
      '@type': 'Question',
      name: 'Wo kann ich offizielle Informationen überprüfen?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Referenzquellen bleiben die offiziellen Websites und Vertretungen der thailändischen Regierung. Wir verweisen Sie ergänzend zu unserer Begleitung auf diese Quellen.',
      },
    },
    {
      '@type': 'Question',
      name: 'Erlaubt das DTV die Arbeit für ein thailändisches Unternehmen?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nein, außer in speziell geregelten Fällen. Das DTV richtet sich in erster Linie an Tätigkeiten für Kunden oder einen Arbeitgeber außerhalb Thailands, nicht an eine Anstellung bei einem thailändischen Unternehmen.',
      },
    },
    {
      '@type': 'Question',
      name: 'Kann ich die DTV-Kategorie während der Gültigkeit wechseln?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Eine Änderung der Situation (z. B. von Fernarbeiter zu Ehepartner eines thailändischen Staatsangehörigen) kann einen neuen Antrag erfordern statt einer einfachen Änderung. Wir prüfen solche Fälle individuell während der Diagnose.',
      },
    },
    {
      '@type': 'Question',
      name: 'Gibt das DTV Zugang zur thailändischen Sozialversicherung?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Nein. Das DTV gewährt keinen Anspruch auf die thailändische Sozialversicherung. Eine an Ihren Aufenthalt angepasste Krankenversicherung bleibt erforderlich und wird in der Regel im Rahmen der Unterlagen verlangt.',
      },
    },
  ],
};
---

<BaseLayout
  title="Das Destination Thailand Visa (DTV) verstehen"
  description="Was ist das DTV, für wen ist es gedacht, welche Hauptkategorien von Profilen sind betroffen: der Ratgeber von MyVisaDTV."
  structuredData={faqSchema}
  lang="de"
  translated
>
  <!-- Hero -->
  <section class="border-b border-sable-light bg-papier">
    <div class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-24">
      <p class="eyebrow mb-4">Ratgeber</p>
      <h1 class="max-w-2xl font-display text-4xl leading-tight text-indigo md:text-5xl">
        Das Destination Thailand Visa, einfach erklärt
      </h1>
      <p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-encre/80">
        Bevor Sie Ihre Unterlagen zusammenstellen, sollten Sie verstehen, was dieses Visum
        tatsächlich abdeckt, für wen es gedacht ist und was damit nicht möglich ist.
      </p>
      <div class="mt-8">
        <DerniereMiseAJour date="2026-08-26" />
      </div>
    </div>
  </section>

  <!-- Qu'est-ce que le DTV -->
  <section class="section">
    <div class="grid gap-12 md:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow mb-3">Die Grundlagen</p>
        <h2 class="font-display text-3xl text-indigo">Was ist das DTV?</h2>
      </div>
      <div class="space-y-5 font-sans text-base leading-relaxed text-encre/85">
        <p>
          Das Destination Thailand Visa (DTV) ist eine thailändische Langzeit-Visumkategorie
          für Profile, die weder unter klassischen Tourismus noch unter einen lokalen
          Arbeitsvertrag fallen: Fernarbeiter, Selbstständige, Teilnehmer an begleiteten
          kulturellen oder sportlichen Aktivitäten oder Ehepartner thailändischer
          Staatsangehöriger.
        </p>
        <p>
          Konkret ermöglicht es einen längeren Aufenthalt in Thailand, ohne einen
          thailändischen Arbeitgeber zu erfordern, stellt aber genaue Bedingungen an
          Ressourcen, Nachweis der Tätigkeit und vorzulegende Unterlagen.
        </p>
        <p class="text-sm text-sable">
          Beträge, Laufzeiten und genaue Kategorien ändern sich mit der Zeit: Wir besprechen
          sie mit Ihnen während der Diagnose, auf Basis der aktuellsten verfügbaren
          Informationen.
        </p>
      </div>
    </div>
  </section>

  <!-- Profils concernés -->
  <section class="section border-t border-sable-light">
    <p class="eyebrow mb-3">Zielgruppe</p>
    <h2 class="max-w-xl font-display text-3xl text-indigo">Die wichtigsten Profilgruppen</h2>

    <div class="mt-10 grid gap-8 md:grid-cols-2">
      <div class="rounded-lg border border-sable-light p-7">
        <h3 class="font-display text-xl text-indigo">Fernarbeiter und Selbstständige</h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          Personen, die remote für einen Arbeitgeber oder Kunden außerhalb Thailands
          arbeiten.
        </p>
      </div>
      <div class="rounded-lg border border-sable-light p-7">
        <h3 class="font-display text-xl text-indigo">Teilnehmer an einer begleiteten Aktivität</h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          Personen, die an einer Ausbildung, einem kulturellen oder sportlichen Programm
          oder einem anerkannten Programm in Thailand über einen längeren Zeitraum
          teilnehmen.
        </p>
      </div>
      <div class="rounded-lg border border-sable-light p-7">
        <h3 class="font-display text-xl text-indigo">Ehepartner thailändischer Staatsangehöriger</h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          Mit einem thailändischen Staatsangehörigen verheiratete Personen, vorbehaltlich
          spezifischer Nachweise für diese Situation.
        </p>
      </div>
      <div class="rounded-lg border border-sable-light p-7">
        <h3 class="font-display text-xl text-indigo">Andere zu prüfende Situationen</h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          Da jede Situation individuell ist, bleibt die Eignungsprüfung der beste Weg, um
          genau zu wissen, wo Sie stehen.
        </p>
      </div>
    </div>
  </section>

  <!-- Ce que le DTV ne permet pas -->
  <section class="section border-t border-sable-light bg-jade-bg">
    <div class="max-w-2xl">
      <p class="eyebrow mb-3">Worauf Sie achten sollten</p>
      <h2 class="font-display text-3xl text-indigo">Was das DTV nicht erlaubt</h2>
      <ul class="mt-6 space-y-4 font-sans text-sm leading-relaxed text-encre/85">
        <li>— Es ist keine dauerhafte Aufenthaltserlaubnis und kein direkter Weg zur thailändischen Staatsangehörigkeit.</li>
        <li>— Es erlaubt keine direkt bezahlte Tätigkeit bei einem thailändischen Unternehmen, außer in speziell geregelten Fällen.</li>
        <li>— Die Verlängerungsbedingungen hängen von der ursprünglichen Kategorie ab und sollten weit vor Ablauf des Aufenthalts geplant werden.</li>
      </ul>
    </div>
  </section>

  <!-- Pourquoi se faire accompagner (transition vers offre) -->
  <section class="section border-t border-sable-light">
    <div class="flex flex-wrap items-center justify-between gap-8 rounded-lg border border-sable-light bg-white p-10">
      <div class="max-w-md">
        <h2 class="font-display text-2xl text-indigo">Jetzt wissen Sie, was Sie erwartet.</h2>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          Das vollständige MyVisaDTV-Paket übernimmt den Rest und macht daraus konkrete,
          einreichfertige Unterlagen.
        </p>
      </div>
      <a href="/de/visa-dtv/demande-accompagnee/" class="btn-primary">Das 700-€-Paket ansehen</a>
    </div>
  </section>

  <!-- FAQ pédagogique -->
  <section class="section border-t border-sable-light">
    <p class="eyebrow mb-3">Häufig gestellte Fragen</p>
    <h2 class="mb-8 max-w-xl font-display text-3xl text-indigo">Mehr erfahren</h2>

    <div class="max-w-2xl">
      <FaqItem question="Ersetzt das DTV ein klassisches Arbeitsvisum?">
        Nein. Es deckt andere Situationen ab, insbesondere Fernarbeit für einen
        ausländischen Arbeitgeber. Eine direkte Anstellung bei einem thailändischen
        Unternehmen fällt in der Regel unter eine andere Visumkategorie.
      </FaqItem>
      <FaqItem question="Kann ich meine Familie mit einem DTV mitbringen?">
        Bestimmte familiäre Situationen werden je nach den Bedingungen der jeweiligen
        Kategorie berücksichtigt. Wir prüfen dies gemeinsam mit Ihnen während der Diagnose.
      </FaqItem>
      <FaqItem question="Wo kann ich offizielle Informationen überprüfen?">
        Referenzquellen bleiben die offiziellen Websites und Vertretungen der
        thailändischen Regierung. Wir verweisen Sie ergänzend zu unserer Begleitung auf
        diese Quellen.
      </FaqItem>
      <FaqItem question="Erlaubt das DTV die Arbeit für ein thailändisches Unternehmen?">
        Nein, außer in speziell geregelten Fällen. Das DTV richtet sich in erster Linie an
        Tätigkeiten für Kunden oder einen Arbeitgeber außerhalb Thailands, nicht an eine
        Anstellung bei einem thailändischen Unternehmen.
      </FaqItem>
      <FaqItem question="Kann ich die DTV-Kategorie während der Gültigkeit wechseln?">
        Eine Änderung der Situation (z. B. von Fernarbeiter zu Ehepartner eines
        thailändischen Staatsangehörigen) kann einen neuen Antrag erfordern statt einer
        einfachen Änderung. Wir prüfen solche Fälle individuell während der Diagnose.
      </FaqItem>
      <FaqItem question="Gibt das DTV Zugang zur thailändischen Sozialversicherung?">
        Nein. Das DTV gewährt keinen Anspruch auf die thailändische Sozialversicherung. Eine
        an Ihren Aufenthalt angepasste Krankenversicherung bleibt erforderlich und wird in
        der Regel im Rahmen der Unterlagen verlangt.
      </FaqItem>
    </div>
  </section>
</BaseLayout>
