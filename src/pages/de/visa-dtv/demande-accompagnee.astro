---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CheckItem from '../../../components/CheckItem.astro';
import StepCard from '../../../components/StepCard.astro';
import FaqItem from '../../../components/FaqItem.astro';
import CalInline from '../../../components/CalInline.astro';
import DerniereMiseAJour from '../../../components/DerniereMiseAJour.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Begleiteter DTV-Visumantrag',
      serviceType: 'Administrative Visumbegleitung',
      provider: {
        '@type': 'ProfessionalService',
        name: 'MyVisaDTV',
        url: 'https://myvisadtv.com',
      },
      areaServed: 'FR',
      offers: {
        '@type': 'Offer',
        price: '699',
        priceCurrency: 'EUR',
        url: 'https://myvisadtv.com/de/visa-dtv/demande-accompagnee/',
        availability: 'https://schema.org/InStock',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Muss ich die 699 € vor der Diagnose bezahlen?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Nein. Die anfängliche Diagnose, basierend auf Ihrem Kontaktformular, ist kostenlos und unverbindlich. Die Zahlung erfolgt erst, nachdem Sie der Zusammenstellung der Unterlagen zugestimmt haben.',
          },
        },
        {
          '@type': 'Question',
          name: 'Was passiert, wenn mein Antrag abgelehnt wird?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Wir prüfen gemeinsam mit Ihnen die Gründe für die Entscheidung und die möglichen Optionen. Die Bedingungen einer eventuellen weiteren Begleitung werden Ihnen im Einzelfall klar mitgeteilt.',
          },
        },
        {
          '@type': 'Question',
          name: 'Kann ich in Raten zahlen?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Nein. Die Zahlung erfolgt in einem Betrag, online per Karte, bevor wir mit der Vorbereitung Ihrer Unterlagen beginnen.',
          },
        },
        {
          '@type': 'Question',
          name: 'Wie läuft die Zahlung der 699 € ab?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Die Zahlung erfolgt nach der kostenlosen Diagnose, sobald Sie der Zusammenstellung der Unterlagen zugestimmt haben. Sie kann online per Karte erfolgen.',
          },
        },
        {
          '@type': 'Question',
          name: 'Sind die offiziellen Visumgebühren in den 699 € enthalten?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Ja, die für Ihren Antrag geltenden offiziellen Visumgebühren sind im Paket enthalten, im Rahmen der bei Bestellung genannten Bedingungen. Kosten für beglaubigte Übersetzungen oder Legalisation von Dokumenten bleiben Ihre eigene Verantwortung.',
          },
        },
        {
          '@type': 'Question',
          name: 'Kann ich während des Verfahrens kündigen?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Ja, Sie bleiben jederzeit frei. Die Bedingungen einer eventuellen Kündigung während des Verfahrens werden Ihnen vor der Zahlung mitgeteilt, damit Sie in voller Kenntnis der Sachlage zustimmen.',
          },
        },
        {
          '@type': 'Question',
          name: "Wer reicht den Antrag ein und kommuniziert mit der Botschaft?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Das übernehmen wir. Wir reichen Ihren Antrag über das offizielle e-Visa-Portal ein und beantworten Anfragen der Botschaft, die über dieses Portal kommen, etwa Nachforderungen. Das Einzige, was wir nicht für Sie tun können: persönlich erscheinen, wenn die Botschaft Sie einlädt. In diesem Fall bereiten wir Sie auf den Termin vor.",
          },
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Begleiteter DTV-Visumantrag — 699 €"
  description="Das MyVisaDTV-Komplettpaket für 699 €: vollständige Vorbereitung der Unterlagen, Einreichung des Antrags durch uns und Begleitung bis zur Entscheidung. Offizielle Visumgebühren inbegriffen."
  structuredData={structuredData}
  lang="de"
  translated
>
  <!-- Hero produit -->
  <section class="border-b border-sable-light bg-papier">
    <div class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-24">
      <p class="eyebrow mb-4">Komplettpaket</p>
      <div class="grid gap-12 md:grid-cols-[1.1fr_0.9fr] md:items-start">
        <div>
          <h1 class="font-display text-4xl leading-tight text-indigo md:text-5xl">
            DTV-Visumantrag, von Anfang bis Ende begleitet
          </h1>
          <p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-encre/80">
            Wir bereiten Ihre vollständigen Unterlagen vor, reichen den Antrag für Sie ein und
            begleiten ihn bis zur Entscheidung der thailändischen Behörden. Sie schicken uns Ihre
            Dokumente und geben die Unterlagen vor der Einreichung frei.
          </p>
          <div class="mt-8">
            <DerniereMiseAJour date="2026-11-17" />
          </div>
        </div>

        <div class="rounded-lg border border-sable-light bg-white p-8">
          <p class="font-mono text-xs uppercase tracking-wide text-sable">Aktuelles Angebot</p>
          <p class="-mt-1 font-display text-5xl text-indigo">699 €</p>
          <p class="mt-2 font-sans text-sm text-encre/70">Offizielle Visumgebühren inbegriffen, im Rahmen des zum Zeitpunkt der Einreichung geltenden Satzes.</p>
          <a href="/de/fiche-renseignement/" class="btn-primary mt-6 w-full">Antrag jetzt starten</a>
          <a
            href="https://buy.stripe.com/aFafZiaUU6iC9LlfQc14402"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary mt-3 w-full"
          >
            Schon entschieden? Jetzt bezahlen
          </a>
          <p class="mt-4 font-sans text-xs text-sable">
            Kosten für beglaubigte Übersetzungen oder Legalisation von Dokumenten bleiben
            Ihre eigene Verantwortung und sind in diesem Preis nicht enthalten.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ce qui est inclus -->
  <section class="section">
    <p class="eyebrow mb-3">Leistungsumfang</p>
    <h2 class="max-w-xl font-display text-3xl text-indigo">Was wir für Sie übernehmen, in 3 Schritten</h2>

    <div class="mt-10 grid gap-10 md:grid-cols-3">
      <div>
        <p class="font-display text-2xl text-or-dark">01</p>
        <h3 class="mt-2 font-display text-xl text-indigo">Vollständige Vorbereitung der Unterlagen</h3>
        <ul class="mt-5 space-y-4">
          <CheckItem variant="gold">Ausführliche Eignungsprüfung (Berufsstatus, Einkommen, familiäre Situation)</CheckItem>
          <CheckItem variant="gold">Individuelle Liste der zu beschaffenden Unterlagen</CheckItem>
          <CheckItem variant="gold">Prüfung und Aufbereitung jedes Dokuments</CheckItem>
          <CheckItem variant="gold">Vollständiges Antragsdossier, bereit zur Einreichung</CheckItem>
        </ul>
      </div>
      <div>
        <p class="font-display text-2xl text-or-dark">02</p>
        <h3 class="mt-2 font-display text-xl text-indigo">Einreichung des Antrags</h3>
        <ul class="mt-5 space-y-4">
          <CheckItem variant="gold">Wir reichen Ihren Antrag über das offizielle thailändische e-Visa-Portal ein</CheckItem>
          <CheckItem variant="gold">Wir bezahlen die offiziellen Visumgebühren, in den 699 € enthalten</CheckItem>
          <CheckItem variant="gold">Sie werden informiert, sobald der Antrag eingereicht ist</CheckItem>
        </ul>
      </div>
      <div>
        <p class="font-display text-2xl text-or-dark">03</p>
        <h3 class="mt-2 font-display text-xl text-indigo">Begleitung bis zur Entscheidung</h3>
        <ul class="mt-5 space-y-4">
          <CheckItem variant="gold">Verfolgung des Antrags bis zur Bekanntgabe der Entscheidung</CheckItem>
          <CheckItem variant="gold">Beantwortung von Nachforderungen der Botschaft</CheckItem>
          <CheckItem variant="gold">Ein persönlicher Berater, während des gesamten Verfahrens per E-Mail erreichbar</CheckItem>
          <CheckItem variant="gold">Vorbereitung auf ein Gespräch, falls die Botschaft eines verlangt</CheckItem>
        </ul>
      </div>
    </div>

    <div class="mt-12 rounded-lg border border-sable-light bg-white p-8">
      <h3 class="font-display text-xl text-indigo">Was Sie selbst tun</h3>
      <ul class="mt-4 space-y-2 font-sans text-sm leading-relaxed text-encre/80">
        <li>— Die angeforderten Dokumente beschaffen und uns über Ihren sicheren Bereich senden.</li>
        <li>— Die vollständigen Unterlagen prüfen und uns vor der Einreichung Ihre Freigabe geben.</li>
        <li>— Sich bei der Einreichung außerhalb Thailands aufhalten, wie es das Verfahren verlangt.</li>
        <li>— Nur dann persönlich zur Botschaft gehen, wenn sie Sie einlädt.</li>
      </ul>
    </div>
  </section>

  <!-- Ce qui n'est pas inclus / honnêteté -->
  <section class="section border-t border-sable-light">
    <div class="rounded-lg border border-sable-light bg-white/60 p-8 md:p-10">
      <h2 class="font-display text-2xl text-indigo">Was dieses Paket nicht abdeckt</h2>
      <ul class="mt-6 space-y-4 font-sans text-sm leading-relaxed text-encre/80">
        <li>— Die Erteilung des Visums ist niemals garantiert: Die Entscheidung liegt bei den thailändischen Behörden.</li>
        <li>— Kosten für beglaubigte Übersetzungen oder Legalisation von Dokumenten bleiben Ihre eigene Verantwortung.</li>
        <li>— Verfahren nach Ihrer Ankunft in Thailand (Meldungen, Verlängerungen) sind nicht enthalten und werden separat begleitet.</li>
      </ul>
    </div>
  </section>

  <!-- Vérification du dossier (99 €) -->
  <section class="section">
    <div class="flex flex-wrap items-center justify-between gap-6 rounded-lg border border-sable-light bg-white p-8 md:p-10">
      <div class="max-w-xl">
        <p class="eyebrow mb-2">Sie beantragen selbst?</p>
        <h2 class="font-display text-2xl text-indigo">Lassen Sie Ihre Unterlagen für 99 € prüfen</h2>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">Fehlende Dokumente, Übereinstimmung mit den offiziellen Anforderungen, Stimmigkeit Ihrer Unterlagen: schriftlicher Bericht innerhalb von 48 Arbeitsstunden. Die 99 € werden angerechnet, wenn Sie danach das Komplettpaket wählen.</p>
      </div>
      <a href="/de/visa-dtv/verification-dossier/" class="btn-secondary">Zur Unterlagenprüfung</a>
    </div>
  </section>

  <!-- Déroulé détaillé -->
  <section class="section border-t border-sable-light">
    <p class="eyebrow mb-3">Ablauf</p>
    <h2 class="max-w-xl font-display text-3xl text-indigo">So läuft die Begleitung ab</h2>

    <div class="mt-8 max-w-2xl">
      <StepCard number="01" title="Eignungsprüfung" duration="1 bis 2 Tage">
        Sie füllen das Kontaktformular aus. Wir analysieren es und melden uns mit einer
        ersten begründeten Einschätzung Ihrer Situation, vor jeder Zahlung.
      </StepCard>
      <StepCard number="02" title="Vorbereitung der Unterlagen" duration="1 bis 3 Wochen">
        Ihr Berater schickt Ihnen die genaue Liste der Dokumente und prüft, ordnet und
        bereitet jedes Dokument auf, sobald es vorliegt.
      </StepCard>
      <StepCard number="03" title="Ihre Freigabe" duration="1 bis 2 Tage">
        Wir zeigen Ihnen die vollständigen Unterlagen. Sie prüfen sie und geben uns die
        Freigabe zur Einreichung.
      </StepCard>
      <StepCard number="04" title="Einreichung durch uns" duration="Sobald Sie freigeben">
        Wir reichen den Antrag über das offizielle e-Visa-Portal ein und bezahlen die
        offiziellen Visumgebühren. Sie werden sofort informiert.
      </StepCard>
      <StepCard number="05" title="Begleitung bis zur Entscheidung" duration="Je nach Fristen der Botschaft">
        Wir verfolgen den Antrag, beantworten Nachforderungen und halten Sie bis zur
        Entscheidung der thailändischen Behörden auf dem Laufenden.
      </StepCard>
    </div>
  </section>

  <!-- FAQ produit -->
  <section class="section border-t border-sable-light bg-jade-bg">
    <p class="eyebrow mb-3">Fragen zum Angebot</p>
    <h2 class="mb-8 max-w-xl font-display text-3xl text-indigo">Bevor Sie starten</h2>

    <div class="max-w-2xl">
      <FaqItem question="Muss ich die 699 € vor der Diagnose bezahlen?">
        Nein. Die anfängliche Diagnose, basierend auf Ihrem Kontaktformular, ist kostenlos
        und unverbindlich. Die Zahlung erfolgt erst, nachdem Sie der Zusammenstellung der
        Unterlagen zugestimmt haben.
      </FaqItem>
      <FaqItem question="Was passiert, wenn mein Antrag abgelehnt wird?">
        Wir prüfen gemeinsam mit Ihnen die Gründe für die Entscheidung und die möglichen
        Optionen. Die Bedingungen einer eventuellen weiteren Begleitung werden Ihnen im
        Einzelfall klar mitgeteilt.
      </FaqItem>
      <FaqItem question="Kann ich in Raten zahlen?">
        Nein. Die Zahlung erfolgt in einem Betrag, online per Karte, bevor wir mit der Vorbereitung Ihrer Unterlagen beginnen.
      </FaqItem>
      <FaqItem question="Wie läuft die Zahlung der 699 € ab?">
        Die Zahlung erfolgt nach der kostenlosen Diagnose, sobald Sie der Zusammenstellung
        der Unterlagen zugestimmt haben. Sie kann online per Karte erfolgen.
      </FaqItem>
      <FaqItem question="Sind die offiziellen Visumgebühren in den 699 € enthalten?">
        Ja, die für Ihren Antrag geltenden offiziellen Visumgebühren sind im Paket
        enthalten, im Rahmen der bei Bestellung genannten Bedingungen. Kosten für
        beglaubigte Übersetzungen oder Legalisation von Dokumenten bleiben Ihre eigene
        Verantwortung.
      </FaqItem>
      <FaqItem question="Kann ich während des Verfahrens kündigen?">
        Ja, Sie bleiben jederzeit frei. Die Bedingungen einer eventuellen Kündigung während
        des Verfahrens werden Ihnen vor der Zahlung mitgeteilt, damit Sie in voller Kenntnis
        der Sachlage zustimmen.
      </FaqItem>
      <FaqItem question="Wer reicht den Antrag ein und kommuniziert mit der Botschaft?">
        Das übernehmen wir. Wir reichen Ihren Antrag über das offizielle e-Visa-Portal ein und
        beantworten Anfragen der Botschaft, die über dieses Portal kommen, etwa Nachforderungen.
        Das Einzige, was wir nicht für Sie tun können: persönlich erscheinen, wenn die Botschaft
        Sie einlädt. In diesem Fall bereiten wir Sie auf den Termin vor.
      </FaqItem>
    </div>
  </section>

  <!-- Réservation appel (Cal.com intégré) -->
  <CalInline lang="de" />

  <!-- CTA final -->
  <section class="border-t border-sable-light bg-indigo text-papier">
    <div class="section text-center">
      <h2 class="mx-auto max-w-xl font-display text-3xl text-papier">
        Bereit, Ihre Unterlagen einem persönlichen Berater anzuvertrauen?
      </h2>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/de/fiche-renseignement/" class="btn-primary inline-flex">Antrag jetzt starten</a>
        <a
          href="https://buy.stripe.com/aFafZiaUU6iC9LlfQc14402"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-on-dark inline-flex"
        >
          Jetzt bezahlen (699 €)
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
