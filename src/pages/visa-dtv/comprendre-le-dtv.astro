---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqItem from '../../components/FaqItem.astro';
import DerniereMiseAJour from '../../components/DerniereMiseAJour.astro';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Le DTV remplace-t-il un visa de travail classique ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Non. Il répond à des situations différentes, notamment le travail à distance pour un employeur étranger. Un emploi salarié directement auprès d'une entreprise thaïlandaise relève généralement d'une autre catégorie de visa.",
      },
    },
    {
      '@type': 'Question',
      name: 'Puis-je faire venir ma famille avec un DTV ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Certaines situations familiales sont prises en compte selon des conditions propres à chaque catégorie. Nous l\'examinons avec vous lors du diagnostic.',
      },
    },
    {
      '@type': 'Question',
      name: 'Où puis-je vérifier les informations officielles ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Les sources de référence restent les sites et représentations officiels du gouvernement thaïlandais. Nous vous orientons vers ces sources en complément de notre accompagnement.',
      },
    },
    {
      '@type': 'Question',
      name: 'Le DTV permet-il de travailler pour une entreprise thaïlandaise ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Non, sauf cas spécifiquement encadrés. Le DTV vise avant tout une activité exercée pour des clients ou un employeur situés hors de Thaïlande, pas un emploi salarié auprès d'une entreprise thaïlandaise.",
      },
    },
    {
      '@type': 'Question',
      name: 'Puis-je changer de catégorie DTV en cours de validité ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Un changement de situation (par exemple de télétravailleur à conjoint d'un ressortissant thaïlandais) peut nécessiter une nouvelle démarche plutôt qu'une simple modification. Nous étudions ce type de cas individuellement lors du diagnostic.",
      },
    },
    {
      '@type': 'Question',
      name: 'Le DTV donne-t-il accès à la sécurité sociale thaïlandaise ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Non. Le DTV n'ouvre pas de droit à la sécurité sociale thaïlandaise. Une assurance santé adaptée à votre séjour reste nécessaire, et généralement demandée dans le cadre de la constitution du dossier.",
      },
    },
  ],
};
---

<BaseLayout
  title="Comprendre le Destination Thailand Visa (DTV)"
  description="Qu'est-ce que le DTV, à qui s'adresse-t-il, quelles sont les grandes catégories de profils concernés : le guide pédagogique de MyVisaDTV."
  structuredData={faqSchema}
>
  <!-- Hero -->
  <section class="border-b border-sable-light bg-papier">
    <div class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-24">
      <p class="eyebrow mb-4">Guide pédagogique</p>
      <h1 class="max-w-2xl font-display text-4xl leading-tight text-indigo md:text-5xl">
        Le Destination Thailand Visa, expliqué simplement
      </h1>
      <p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-encre/80">
        Avant de constituer un dossier, mieux vaut comprendre ce que couvre réellement ce visa,
        à qui il s'adresse, et ce qu'il ne permet pas de faire.
      </p>
      <div class="mt-8">
        <DerniereMiseAJour date="2026-08-26" />
      </div>
    </div>
  </section>

  <!-- Qu'est-ce que le DTV -->
  <section class="section">
    <div class="grid gap-12 md:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow mb-3">La base</p>
        <h2 class="font-display text-3xl text-indigo">Qu'est-ce que le DTV ?</h2>
      </div>
      <div class="space-y-5 font-sans text-base leading-relaxed text-encre/85">
        <p>
          Le Destination Thailand Visa (DTV) est une catégorie de visa de long séjour thaïlandais
          conçue pour des profils qui ne relèvent ni du tourisme classique, ni d'un contrat de
          travail local : télétravailleurs, indépendants, participants à des activités
          culturelles ou sportives encadrées, ou conjoints de ressortissants thaïlandais.
        </p>
        <p>
          Concrètement, il permet un séjour prolongé en Thaïlande sans nécessiter d'employeur
          thaïlandais, tout en imposant des conditions précises sur les ressources, la
          justification d'activité et les documents à fournir.
        </p>
        <p class="text-sm text-sable">
          Les montants, durées et catégories précises évoluent avec le temps : nous les
          détaillons avec vous lors du diagnostic, sur la base des informations les plus
          récentes disponibles.
        </p>
      </div>
    </div>
  </section>

  <!-- Profils concernés -->
  <section class="section border-t border-sable-light">
    <p class="eyebrow mb-3">Public concerné</p>
    <h2 class="max-w-xl font-display text-3xl text-indigo">Les grandes familles de profils</h2>

    <div class="mt-10 grid gap-8 md:grid-cols-2">
      <div class="rounded-lg border border-sable-light p-7">
        <h3 class="font-display text-xl text-indigo">Télétravailleurs et indépendants</h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          Personnes exerçant une activité professionnelle à distance pour un employeur ou des
          clients situés hors de Thaïlande.
        </p>
      </div>
      <div class="rounded-lg border border-sable-light p-7">
        <h3 class="font-display text-xl text-indigo">Participants à une activité encadrée</h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          Personnes engagées dans une formation, un stage culturel ou sportif, ou un programme
          reconnu se déroulant en Thaïlande sur une période prolongée.
        </p>
      </div>
      <div class="rounded-lg border border-sable-light p-7">
        <h3 class="font-display text-xl text-indigo">Conjoints de ressortissants thaïlandais</h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          Personnes mariées à un ressortissant thaïlandais, sous réserve de justificatifs
          spécifiques liés à cette situation.
        </p>
      </div>
      <div class="rounded-lg border border-sable-light p-7">
        <h3 class="font-display text-xl text-indigo">Autres situations à évaluer</h3>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          Chaque situation étant particulière, le diagnostic d'éligibilité reste la meilleure
          façon de savoir précisément où vous vous situez.
        </p>
      </div>
    </div>
  </section>

  <!-- Ce que le DTV ne permet pas -->
  <section class="section border-t border-sable-light bg-jade-bg">
    <div class="max-w-2xl">
      <p class="eyebrow mb-3">Points de vigilance</p>
      <h2 class="font-display text-3xl text-indigo">Ce que le DTV ne permet pas</h2>
      <ul class="mt-6 space-y-4 font-sans text-sm leading-relaxed text-encre/85">
        <li>— Il ne s'agit pas d'un titre de résidence permanente ni d'une voie directe vers la nationalité thaïlandaise.</li>
        <li>— Il n'autorise pas l'exercice d'une activité professionnelle rémunérée directement par une entreprise thaïlandaise, sauf cas spécifiquement encadrés.</li>
        <li>— Les conditions de renouvellement dépendent de la catégorie initiale et doivent être anticipées bien avant l'échéance du séjour.</li>
      </ul>
    </div>
  </section>

  <!-- Pourquoi se faire accompagner (transition vers offre) -->
  <section class="section border-t border-sable-light">
    <div class="flex flex-wrap items-center justify-between gap-8 rounded-lg border border-sable-light bg-white p-10">
      <div class="max-w-md">
        <h2 class="font-display text-2xl text-indigo">Vous savez maintenant à quoi vous attendre.</h2>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">
          La formule complète MyVisaDTV prend le relais pour transformer cette compréhension en
          dossier concret, prêt à être déposé.
        </p>
      </div>
      <a href="/visa-dtv/demande-accompagnee/" class="btn-primary">Voir la formule à 700 €</a>
    </div>
  </section>

  <!-- FAQ pédagogique -->
  <section class="section border-t border-sable-light">
    <p class="eyebrow mb-3">Questions fréquentes</p>
    <h2 class="mb-8 max-w-xl font-display text-3xl text-indigo">Pour aller plus loin</h2>

    <div class="max-w-2xl">
      <FaqItem question="Le DTV remplace-t-il un visa de travail classique ?">
        Non. Il répond à des situations différentes, notamment le travail à distance pour un
        employeur étranger. Un emploi salarié directement auprès d'une entreprise thaïlandaise
        relève généralement d'une autre catégorie de visa.
      </FaqItem>
      <FaqItem question="Puis-je faire venir ma famille avec un DTV ?">
        Certaines situations familiales sont prises en compte selon des conditions propres à
        chaque catégorie. Nous l'examinons avec vous lors du diagnostic.
      </FaqItem>
      <FaqItem question="Où puis-je vérifier les informations officielles ?">
        Les sources de référence restent les sites et représentations officiels du gouvernement
        thaïlandais. Nous vous orientons vers ces sources en complément de notre accompagnement.
      </FaqItem>
      <FaqItem question="Le DTV permet-il de travailler pour une entreprise thaïlandaise ?">
        Non, sauf cas spécifiquement encadrés. Le DTV vise avant tout une activité exercée pour
        des clients ou un employeur situés hors de Thaïlande, pas un emploi salarié auprès d'une
        entreprise thaïlandaise.
      </FaqItem>
      <FaqItem question="Puis-je changer de catégorie DTV en cours de validité ?">
        Un changement de situation (par exemple de télétravailleur à conjoint d'un ressortissant
        thaïlandais) peut nécessiter une nouvelle démarche plutôt qu'une simple modification.
        Nous étudions ce type de cas individuellement lors du diagnostic.
      </FaqItem>
      <FaqItem question="Le DTV donne-t-il accès à la sécurité sociale thaïlandaise ?">
        Non. Le DTV n'ouvre pas de droit à la sécurité sociale thaïlandaise. Une assurance santé
        adaptée à votre séjour reste nécessaire, et généralement demandée dans le cadre de la
        constitution du dossier.
      </FaqItem>
    </div>
  </section>
</BaseLayout>
