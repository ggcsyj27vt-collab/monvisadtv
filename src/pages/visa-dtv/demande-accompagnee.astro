---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CheckItem from '../../components/CheckItem.astro';
import StepCard from '../../components/StepCard.astro';
import FaqItem from '../../components/FaqItem.astro';
import CalInline from '../../components/CalInline.astro';
import DerniereMiseAJour from '../../components/DerniereMiseAJour.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Demande de visa DTV accompagnée',
      serviceType: 'Accompagnement administratif visa',
      provider: {
        '@type': 'ProfessionalService',
        name: 'MyVisaDTV',
        url: 'https://myvisadtv.com',
      },
      areaServed: 'FR',
      offers: {
        '@type': 'Offer',
        price: '699',
        priceCurrency: 'EUR',
        url: 'https://myvisadtv.com/visa-dtv/demande-accompagnee/',
        availability: 'https://schema.org/InStock',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Dois-je payer les 699 € avant le diagnostic ?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Non. Le diagnostic initial, réalisé à partir de votre fiche de renseignement, est gratuit et sans engagement. Le paiement n'intervient qu'après votre accord pour lancer la constitution du dossier.",
          },
        },
        {
          '@type': 'Question',
          name: 'Que se passe-t-il si mon dossier est refusé ?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Nous analysons avec vous les motifs de la décision et les options possibles. Les conditions d\'un éventuel nouvel accompagnement vous sont communiquées clairement au cas par cas.',
          },
        },
        {
          '@type': 'Question',
          name: 'Puis-je payer en plusieurs fois ?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Un échelonnement peut être proposé selon les étapes de la procédure. Cette possibilité est discutée avec votre conseiller lors du premier échange.',
          },
        },
        {
          '@type': 'Question',
          name: 'Comment se déroule le paiement des 699 € ?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Le paiement intervient après le diagnostic gratuit, une fois que vous avez donné votre accord pour lancer la constitution du dossier. Il peut être réalisé en ligne, par carte bancaire.",
          },
        },
        {
          '@type': 'Question',
          name: 'Les frais officiels du visa sont-ils inclus dans les 699 € ?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Oui, les frais officiels du visa applicables à votre demande sont inclus dans la formule, dans la limite des conditions précisées lors de votre commande. Les frais de traduction assermentée ou de légalisation de documents restent en revanche à votre charge.",
          },
        },
        {
          '@type': 'Question',
          name: 'Puis-je annuler en cours d\'accompagnement ?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: "Oui, vous restez libre à tout moment. Les conditions d'une éventuelle annulation en cours de procédure vous sont précisées avant le paiement, pour que vous vous engagiez en toute connaissance de cause.",
          },
        },
        {
          '@type': 'Question',
          name: "Qui dépose la demande et échange avec l'ambassade ?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: "C'est nous. Nous déposons votre demande sur le portail officiel e-Visa et nous répondons aux demandes de l'ambassade qui passent par ce portail, comme les pièces complémentaires. La seule chose que nous ne pouvons pas faire à votre place : vous présenter en personne si l'ambassade vous convoque. Dans ce cas, nous vous préparons au rendez-vous.",
          },
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="Demande de visa DTV accompagnée — 699 €"
  description="Formule complète MyVisaDTV à 699 € : préparation complète du dossier, dépôt de la demande par nos soins et suivi jusqu'à la décision. Frais officiels du visa inclus."
  structuredData={structuredData}
  lang="fr"
  translated
>
  <!-- Hero produit -->
  <section class="border-b border-sable-light bg-papier">
    <div class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-24">
      <p class="eyebrow mb-4">Formule complète</p>
      <div class="grid gap-12 md:grid-cols-[1.1fr_0.9fr] md:items-start">
        <div>
          <h1 class="font-display text-4xl leading-tight text-indigo md:text-5xl">
            Demande de visa DTV, accompagnée de bout en bout
          </h1>
          <p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-encre/80">
            Nous préparons votre dossier complet, nous le déposons pour vous, puis nous le suivons
            jusqu'à la décision des autorités thaïlandaises. De votre côté, vous nous transmettez
            vos documents et vous validez le dossier avant le dépôt.
          </p>
          <div class="mt-8">
            <DerniereMiseAJour date="2026-11-17" />
          </div>
        </div>

        <div class="rounded-lg border border-sable-light bg-white p-8">
          <p class="font-mono text-xs uppercase tracking-wide text-sable">Offre actuelle</p>
          <p class="-mt-1 font-display text-5xl text-indigo">699 €</p>
          <p class="mt-2 font-sans text-sm text-encre/70">Frais officiels du visa inclus, dans la limite du tarif applicable au moment du dépôt.</p>
          <a href="/fiche-renseignement/" class="btn-primary mt-6 w-full">Démarrer ma demande</a>
          <a
            href="https://buy.stripe.com/aFafZiaUU6iC9LlfQc14402"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary mt-3 w-full"
          >
            Déjà prêt(e) ? Payer maintenant
          </a>
          <p class="mt-4 font-sans text-xs text-sable">
            Les frais de traduction assermentée ou de légalisation de documents restent à votre
            charge et ne sont pas inclus dans ce tarif.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ce qui est inclus -->
  <section class="section">
    <p class="eyebrow mb-3">Contenu de la formule</p>
    <h2 class="max-w-xl font-display text-3xl text-indigo">Ce que nous faisons pour vous, en 3 étapes</h2>

    <div class="mt-10 grid gap-10 md:grid-cols-3">
      <div>
        <p class="font-display text-2xl text-or-dark">01</p>
        <h3 class="mt-2 font-display text-xl text-indigo">Préparation complète du dossier</h3>
        <ul class="mt-5 space-y-4">
          <CheckItem variant="gold">Diagnostic d'éligibilité détaillé (statut professionnel, revenus, situation familiale)</CheckItem>
          <CheckItem variant="gold">Liste personnalisée des pièces à réunir</CheckItem>
          <CheckItem variant="gold">Relecture et mise en conformité de chaque document</CheckItem>
          <CheckItem variant="gold">Constitution du dossier complet, prêt à être déposé</CheckItem>
        </ul>
      </div>
      <div>
        <p class="font-display text-2xl text-or-dark">02</p>
        <h3 class="mt-2 font-display text-xl text-indigo">Dépôt du dossier</h3>
        <ul class="mt-5 space-y-4">
          <CheckItem variant="gold">Dépôt de votre demande par nos soins sur le portail officiel e-Visa thaïlandais</CheckItem>
          <CheckItem variant="gold">Paiement des frais officiels du visa, inclus dans les 699 €</CheckItem>
          <CheckItem variant="gold">Vous êtes informé dès que la demande est déposée</CheckItem>
        </ul>
      </div>
      <div>
        <p class="font-display text-2xl text-or-dark">03</p>
        <h3 class="mt-2 font-display text-xl text-indigo">Suivi jusqu'à la décision</h3>
        <ul class="mt-5 space-y-4">
          <CheckItem variant="gold">Suivi de la demande jusqu'à la notification de la décision</CheckItem>
          <CheckItem variant="gold">Réponse aux demandes de pièces complémentaires de l'ambassade</CheckItem>
          <CheckItem variant="gold">Un conseiller dédié, joignable par e-mail pendant toute la procédure</CheckItem>
          <CheckItem variant="gold">Préparation à l'entretien, si l'ambassade en demande un</CheckItem>
        </ul>
      </div>
    </div>

    <div class="mt-12 rounded-lg border border-sable-light bg-white p-8">
      <h3 class="font-display text-xl text-indigo">Ce que vous faites de votre côté</h3>
      <ul class="mt-4 space-y-2 font-sans text-sm leading-relaxed text-encre/80">
        <li>— Réunir les documents demandés et nous les transmettre dans votre espace sécurisé.</li>
        <li>— Relire le dossier complet et nous donner votre accord avant le dépôt.</li>
        <li>— Être hors de Thaïlande au moment du dépôt, comme l'exige la procédure.</li>
        <li>— Vous présenter à l'ambassade uniquement si elle vous convoque en personne.</li>
      </ul>
    </div>
  </section>

  <!-- Ce qui n'est pas inclus / honnêteté -->
  <section class="section border-t border-sable-light">
    <div class="rounded-lg border border-sable-light bg-white/60 p-8 md:p-10">
      <h2 class="font-display text-2xl text-indigo">Ce que cette formule ne couvre pas</h2>
      <ul class="mt-6 space-y-4 font-sans text-sm leading-relaxed text-encre/80">
        <li>— L'obtention du visa n'est jamais garantie : la décision appartient aux autorités thaïlandaises.</li>
        <li>— Les frais de traduction assermentée ou de légalisation de documents restent à votre charge.</li>
        <li>— Les démarches une fois sur le territoire thaïlandais (déclarations de séjour, renouvellements) ne sont pas incluses et font l'objet d'un accompagnement séparé.</li>
      </ul>
    </div>
  </section>

  <!-- Vérification du dossier (99 €) -->
  <section class="section">
    <div class="flex flex-wrap items-center justify-between gap-6 rounded-lg border border-sable-light bg-white p-8 md:p-10">
      <div class="max-w-xl">
        <p class="eyebrow mb-2">Vous déposez seul ?</p>
        <h2 class="font-display text-2xl text-indigo">Faites vérifier votre dossier pour 99 €</h2>
        <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">Pièces manquantes, conformité aux exigences officielles, cohérence entre vos documents : rapport écrit sous 48 h ouvrées. Les 99 € sont déduits si vous passez ensuite à la formule complète.</p>
      </div>
      <a href="/visa-dtv/verification-dossier/" class="btn-secondary">Découvrir la vérification</a>
    </div>
  </section>

  <!-- Déroulé détaillé -->
  <section class="section border-t border-sable-light">
    <p class="eyebrow mb-3">Déroulé</p>
    <h2 class="max-w-xl font-display text-3xl text-indigo">Comment se déroule l'accompagnement</h2>

    <div class="mt-8 max-w-2xl">
      <StepCard number="01" title="Diagnostic d'éligibilité" duration="1 à 2 jours">
        Vous répondez à la fiche de renseignement. Nous l'analysons et revenons vers vous avec
        un premier avis motivé sur votre situation, avant tout paiement.
      </StepCard>
      <StepCard number="02" title="Préparation du dossier" duration="1 à 3 semaines">
        Votre conseiller vous envoie la liste précise des pièces, puis relit, ordonne et met en
        conformité chaque document au fur et à mesure.
      </StepCard>
      <StepCard number="03" title="Validation par vous" duration="1 à 2 jours">
        Nous vous présentons le dossier complet. Vous le relisez et vous nous donnez votre
        accord pour le dépôt.
      </StepCard>
      <StepCard number="04" title="Dépôt par nos soins" duration="Dès votre accord">
        Nous déposons la demande sur le portail officiel e-Visa et réglons les frais officiels
        du visa. Vous êtes informé dès que c'est fait.
      </StepCard>
      <StepCard number="05" title="Suivi jusqu'à la décision" duration="Selon les délais de l'ambassade">
        Nous suivons la demande, répondons aux demandes de pièces complémentaires et vous
        tenons informé jusqu'à la décision des autorités thaïlandaises.
      </StepCard>
    </div>
  </section>

  <!-- FAQ produit -->
  <section class="section border-t border-sable-light bg-jade-bg">
    <p class="eyebrow mb-3">Questions sur l'offre</p>
    <h2 class="mb-8 max-w-xl font-display text-3xl text-indigo">Avant de démarrer</h2>

    <div class="max-w-2xl">
      <FaqItem question="Dois-je payer les 699 € avant le diagnostic ?">
        Non. Le diagnostic initial, réalisé à partir de votre fiche de renseignement, est
        gratuit et sans engagement. Le paiement n'intervient qu'après votre accord pour lancer
        la constitution du dossier.
      </FaqItem>
      <FaqItem question="Que se passe-t-il si mon dossier est refusé ?">
        Nous analysons avec vous les motifs de la décision et les options possibles. Les
        conditions d'un éventuel nouvel accompagnement vous sont communiquées clairement au cas
        par cas.
      </FaqItem>
      <FaqItem question="Puis-je payer en plusieurs fois ?">
        Un échelonnement peut être proposé selon les étapes de la procédure. Cette possibilité
        est discutée avec votre conseiller lors du premier échange.
      </FaqItem>
      <FaqItem question="Comment se déroule le paiement des 699 € ?">
        Le paiement intervient après le diagnostic gratuit, une fois que vous avez donné votre
        accord pour lancer la constitution du dossier. Il peut être réalisé en ligne, par carte
        bancaire.
      </FaqItem>
      <FaqItem question="Les frais officiels du visa sont-ils inclus dans les 699 € ?">
        Oui, les frais officiels du visa applicables à votre demande sont inclus dans la
        formule, dans la limite des conditions précisées lors de votre commande. Les frais de
        traduction assermentée ou de légalisation de documents restent en revanche à votre
        charge.
      </FaqItem>
      <FaqItem question="Puis-je annuler en cours d'accompagnement ?">
        Oui, vous restez libre à tout moment. Les conditions d'une éventuelle annulation en
        cours de procédure vous sont précisées avant le paiement, pour que vous vous engagiez en
        toute connaissance de cause.
      </FaqItem>
      <FaqItem question="Qui dépose la demande et échange avec l'ambassade ?">
        C'est nous. Nous déposons votre demande sur le portail officiel e-Visa et nous répondons
        aux demandes de l'ambassade qui passent par ce portail, comme les pièces
        complémentaires. La seule chose que nous ne pouvons pas faire à votre place : vous
        présenter en personne si l'ambassade vous convoque. Dans ce cas, nous vous préparons au
        rendez-vous.
      </FaqItem>
    </div>
  </section>

  <!-- Réservation appel (Cal.com intégré) -->
  <CalInline lang="fr" />

  <!-- CTA final -->
  <section class="border-t border-sable-light bg-indigo text-papier">
    <div class="section text-center">
      <h2 class="mx-auto max-w-xl font-display text-3xl text-papier">
        Prêt à confier votre dossier à un conseiller dédié ?
      </h2>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/fiche-renseignement/" class="btn-primary inline-flex">Démarrer ma demande</a>
        <a
          href="https://buy.stripe.com/aFafZiaUU6iC9LlfQc14402"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-on-dark inline-flex"
        >
          Payer maintenant (699 €)
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
