---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mon dossier"
  description="Suivez l'avancement de votre dossier, déposez vos documents et échangez avec votre conseiller."
  noindex
>
  <section class="border-b border-sable-light bg-papier">
    <div class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
      <p class="eyebrow mb-4">Espace client</p>
      <h1 class="max-w-2xl font-display text-4xl leading-tight text-indigo md:text-5xl">
        Mon dossier
      </h1>
      <p class="mt-4 max-w-xl font-sans text-base text-encre/70">
        Retrouvez ici l'avancement de votre dossier, déposez vos documents et échangez avec
        votre conseiller.
      </p>
    </div>
  </section>

  <section class="section max-w-3xl">
    <div id="loading-state" class="font-sans text-sm text-encre/60">Chargement de votre dossier…</div>

    <div id="invalid-state" class="hidden rounded-lg border border-sable-light bg-white p-8 text-center">
      <p class="font-display text-xl text-indigo">Lien introuvable</p>
      <p class="mt-3 font-sans text-sm text-encre/70">
        Ce lien ne correspond à aucun dossier actif. Vérifiez que vous avez bien copié
        l'adresse complète reçue par votre conseiller, ou contactez-nous sur
        <a href="/fiche-renseignement/" class="underline hover:text-indigo">WhatsApp</a>.
      </p>
    </div>

    <div id="case-content" class="hidden space-y-10">
      <!-- Statut -->
      <div class="rounded-lg border border-sable-light bg-jade-bg p-6">
        <p class="font-mono text-xs uppercase tracking-wide text-encre/50">Dossier de</p>
        <p class="mt-1 font-display text-2xl text-indigo" id="client-name"></p>
        <p class="mt-3 inline-flex items-center gap-2 rounded-sm bg-white px-3 py-1.5 font-mono text-xs text-jade">
          <span aria-hidden="true">●</span>
          <span id="status-label"></span>
        </p>
      </div>

      <!-- Documents -->
      <div>
        <h2 class="font-display text-2xl text-indigo">Vos documents</h2>
        <p class="mt-2 font-sans text-sm text-encre/70">
          Déposez vos justificatifs ici (PDF, JPG ou PNG, 10 Mo max par fichier). Votre
          conseiller vous précisera la liste exacte attendue.
        </p>

        <form id="upload-form" class="mt-5 flex flex-wrap items-center gap-3">
          <input
            type="file"
            id="file-input"
            accept=".pdf,.jpg,.jpeg,.png"
            class="font-sans text-sm text-encre/80"
          />
          <button type="submit" class="btn-primary" id="upload-btn">Déposer le fichier</button>
        </form>
        <p id="upload-status" class="mt-2 font-sans text-xs text-encre/60"></p>

        <ul id="documents-list" class="mt-6 space-y-2 font-sans text-sm text-encre/85"></ul>
      </div>

      <!-- Messages -->
      <div>
        <h2 class="font-display text-2xl text-indigo">Échanges avec votre conseiller</h2>
        <div id="messages-list" class="mt-5 space-y-4"></div>

        <form id="message-form" class="mt-6 space-y-3">
          <textarea
            id="message-input"
            rows="3"
            placeholder="Écrivez votre message…"
            required
            class="w-full rounded-sm border border-sable-light bg-white px-4 py-3 font-sans text-sm text-encre focus:border-indigo focus:outline-none"
          ></textarea>
          <button type="submit" class="btn-primary">Envoyer</button>
        </form>
      </div>
    </div>
  </section>

  <script>
    import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

    const SUPABASE_URL = 'https://ujrtyrnnhwsfqnftoawt.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_nKqEap0GKlrBNhtwxqivZg_UCtZT8Ek';
    const sb = createClient(SUPABASE_URL, SUPABASE_KEY);

    const statusLabels: Record<string, string> = {
      diagnostic: 'Diagnostic en cours',
      documents: 'Réunion des documents',
      verification: 'Vérification du dossier',
      depot: 'Dossier déposé',
      decision: 'En attente de décision',
      approuve: 'Visa obtenu',
      refuse: 'Dossier refusé',
    };

    const token = new URLSearchParams(window.location.search).get('token');

    const loadingEl = document.getElementById('loading-state')!;
    const invalidEl = document.getElementById('invalid-state')!;
    const contentEl = document.getElementById('case-content')!;

    async function init() {
      if (!token) {
        loadingEl.classList.add('hidden');
        invalidEl.classList.remove('hidden');
        return;
      }

      const { data: caseRows, error } = await sb.rpc('get_case_by_token', { p_token: token });
      const caseData = caseRows?.[0];

      if (error || !caseData) {
        loadingEl.classList.add('hidden');
        invalidEl.classList.remove('hidden');
        return;
      }

      document.getElementById('client-name')!.textContent = caseData.client_name;
      document.getElementById('status-label')!.textContent =
        statusLabels[caseData.status] || caseData.status;

      loadingEl.classList.add('hidden');
      contentEl.classList.remove('hidden');

      await loadDocuments();
      await loadMessages();
    }

    async function loadDocuments() {
      const { data } = await sb.rpc('get_documents_by_token', { p_token: token });
      const list = document.getElementById('documents-list')!;
      list.innerHTML = '';
      (data || []).forEach((doc: any) => {
        const li = document.createElement('li');
        li.className = 'flex items-center gap-2 rounded-sm border border-sable-light bg-white px-4 py-3';
        li.innerHTML = `<span aria-hidden="true">📄</span> <span>${doc.file_name}</span>`;
        list.appendChild(li);
      });
      if (!data || data.length === 0) {
        list.innerHTML = '<li class="font-sans text-sm text-encre/50">Aucun document déposé pour le moment.</li>';
      }
    }

    async function loadMessages() {
      const { data } = await sb.rpc('get_messages_by_token', { p_token: token });
      const list = document.getElementById('messages-list')!;
      list.innerHTML = '';
      (data || []).forEach((msg: any) => {
        const isAdvisor = msg.author === 'advisor';
        const wrapper = document.createElement('div');
        wrapper.className = isAdvisor
          ? 'max-w-md rounded-lg bg-jade-bg px-4 py-3'
          : 'ml-auto max-w-md rounded-lg bg-indigo px-4 py-3 text-papier';
        wrapper.innerHTML = `
          <p class="font-mono text-[10px] uppercase tracking-wide ${isAdvisor ? 'text-jade' : 'text-papier/60'}">${isAdvisor ? 'Votre conseiller' : 'Vous'}</p>
          <p class="mt-1 font-sans text-sm">${msg.body.replace(/</g, '&lt;')}</p>
        `;
        list.appendChild(wrapper);
      });
      if (!data || data.length === 0) {
        list.innerHTML = '<p class="font-sans text-sm text-encre/50">Aucun message pour le moment.</p>';
      }
    }

    document.getElementById('upload-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fileInput = document.getElementById('file-input') as HTMLInputElement;
      const file = fileInput.files?.[0];
      const statusEl = document.getElementById('upload-status')!;
      if (!file || !token) return;

      statusEl.textContent = 'Envoi en cours…';
      const path = `${token}/${Date.now()}-${file.name}`;
      const { error: uploadError } = await sb.storage.from('documents').upload(path, file);
      if (uploadError) {
        statusEl.textContent = "Erreur lors de l'envoi. Réessayez ou contactez-nous.";
        return;
      }
      await sb.rpc('add_document_record', {
        p_token: token,
        p_file_name: file.name,
        p_storage_path: path,
      });
      statusEl.textContent = 'Document envoyé ✓';
      fileInput.value = '';
      await loadDocuments();
    });

    document.getElementById('message-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('message-input') as HTMLTextAreaElement;
      const body = input.value.trim();
      if (!body || !token) return;
      await sb.rpc('add_client_message', { p_token: token, p_body: body });
      input.value = '';
      await loadMessages();
    });

    init();
  </script>
</BaseLayout>
