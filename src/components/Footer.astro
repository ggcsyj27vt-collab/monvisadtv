---
import { ui, localePath, type Locale } from '../i18n/ui';

interface Props {
  lang?: Locale;
}
const { lang = 'fr' } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---

<footer class="border-t border-indigo/10 bg-indigo text-papier">
  <div class="mx-auto max-w-content px-6 py-14 md:px-10">
    <div class="grid gap-10 md:grid-cols-[1.3fr_1fr_1fr]">
      <div>
        <div class="inline-block rounded-md bg-papier p-3">
          <img src="/images/logo-dtv-thailand.png" alt="MyVisaDTV — DTV Thailand Visa Services" class="h-16 w-auto" />
        </div>
        <p class="mt-4 max-w-sm font-sans text-sm leading-relaxed text-papier/70">
          {t.footer.tagline}
        </p>
      </div>

      <div>
        <p class="eyebrow mb-4 text-or">{t.footer.serviceHeading}</p>
        <ul class="space-y-2 font-sans text-sm text-papier/80">
          <li><a class="hover:text-or" href={localePath(lang, '/a-propos/')}>{t.nav.about}</a></li>
          <li><a class="hover:text-or" href={localePath(lang, '/visa-dtv/demande-accompagnee/')}>{t.nav.offer}</a></li>
          <li><a class="hover:text-or" href={localePath(lang, '/visa-dtv/comprendre-le-dtv/')}>{t.nav.understand}</a></li>
          <li><a class="hover:text-or" href="/blog/">{t.nav.blog}</a></li>
          <li><a class="hover:text-or" href={localePath(lang, '/fiche-renseignement/')}>{lang === 'fr' ? 'Fiche de renseignement' : t.nav.startCta}</a></li>
        </ul>
      </div>

      <div>
        <p class="eyebrow mb-4 text-or">{t.footer.infoHeading}</p>
        <ul class="space-y-2 font-sans text-sm text-papier/80">
          <li><a class="hover:text-or" href={localePath(lang, '/mentions-legales/')}>{t.footer.legal}</a></li>
          <li><a class="hover:text-or" href={localePath(lang, '/confidentialite/')}>{t.footer.privacy}</a></li>
          <li><a class="hover:text-or" href="mailto:contact@myvisadtv.com">contact@myvisadtv.com</a></li>
          <li>
            <a
              class="hover:text-or"
              href="https://wa.me/66631747492?text=Bonjour%2C%20je%20souhaite%20en%20savoir%20plus%20sur%20l%27accompagnement%20visa%20DTV."
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-papier/15 pt-6">
      <p class="font-mono text-xs leading-relaxed text-papier/50">
        {t.footer.disclaimer}
      </p>
      <p class="mt-3 font-mono text-xs text-papier/40">© {year} MyVisaDTV. {t.footer.rights}</p>
    </div>
  </div>
</footer>
