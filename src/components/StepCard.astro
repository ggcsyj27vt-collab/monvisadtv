---
interface Props {
  number: string;
  title: string;
  duration?: string;
}
const { number, title, duration } = Astro.props;
---

<div class="flex gap-5 border-b border-sable-light py-8 first:pt-0 last:border-b-0 last:pb-0">
  <span class="font-display text-3xl text-or-dark">{number}</span>
  <div>
    <div class="flex flex-wrap items-baseline gap-3">
      <h3 class="font-display text-xl text-indigo">{title}</h3>
      {duration && <span class="font-mono text-xs uppercase tracking-wide text-sable">{duration}</span>}
    </div>
    <div class="mt-2 font-sans text-sm leading-relaxed text-encre/80">
      <slot />
    </div>
  </div>
</div>
