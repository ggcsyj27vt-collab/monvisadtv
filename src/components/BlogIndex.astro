---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { postLang, postUrl, BLOG_TXT, type BlogLang } from '../lib/blog';

interface Props {
  lang: BlogLang;
}
const { lang } = Astro.props;
const t = BLOG_TXT[lang];
const posts = (await getCollection('blog'))
  .filter((p) => postLang(p) === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={t.indexTitle} description={t.indexDesc} lang={lang} translated>
  <section class="border-b border-sable-light bg-papier">
    <div class="mx-auto max-w-content px-6 py-16 md:px-10 md:py-20">
      <p class="eyebrow mb-4">{t.eyebrow}</p>
      <h1 class="max-w-2xl font-display text-4xl leading-tight text-indigo md:text-5xl">{t.h1}</h1>
      <p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-encre/80">{t.intro}</p>
    </div>
  </section>

  <section class="section">
    {posts.length === 0 && <p class="font-sans text-encre/70">{t.empty}</p>}
    <div class="grid gap-8 md:grid-cols-2">
      {posts.map((post) => (
        <a
          href={postUrl(post)}
          class="group flex flex-col rounded-lg border border-sable-light bg-white p-8 transition hover:border-jade"
        >
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-encre/50">
            {(post.data.updatedDate ?? post.data.pubDate).toLocaleDateString(t.locale, { day: 'numeric', month: 'long', year: 'numeric' })}
          </p>
          <h2 class="mt-3 font-display text-xl leading-snug text-indigo group-hover:text-jade md:text-2xl">{post.data.title}</h2>
          <p class="mt-3 font-sans text-sm leading-relaxed text-encre/70">{post.data.excerpt}</p>
          <span class="mt-5 font-sans text-sm font-semibold text-jade">{t.read}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
