<script define:vars={{ cats: c.cats, statut: STATUT, FORMSPREE, lang }}>
  (function () {
    var form = document.getElementById('quiz');
    var leadForm = document.getElementById('quiz-lead');
    var thanks = document.getElementById('quiz-thanks');
    var box = document.getElementById('quiz-result');
    if (!form || !box || !leadForm) return;
    var track = function (n, d) { try { if (window.umami) window.umami.track(n, d); } catch (e) {} };
    var answers = null;
    var started = false;
    form.addEventListener('change', function () {
      if (!started) track('Test éligibilité : commencé');
      started = true;
      document.getElementById('quiz-missing').classList.add('hidden');
    });

    // 1. Réponses du test -> étape coordonnées
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var get = function (n) { var el = form.querySelector('input[name="' + n + '"]:checked'); return el ? el.value : null; };
      var profil = get('profil'), epargne = get('epargne'), lieu = get('lieu');
      if (!profil || !epargne || !lieu) {
        document.getElementById('quiz-missing').classList.remove('hidden');
        return;
      }
      var result = epargne === 'no' ? 'savings' : lieu === 'inside' ? 'inside' : (profil === 'other' || epargne === 'unsure') ? 'unsure' : 'ok';
      answers = { profil: profil, epargne: epargne, lieu: lieu, result: result };
      leadForm.hidden = false;
      form.querySelector('button[type="submit"]').hidden = true;
      track('Test éligibilité : réponses', { resultat: result, profil: profil });
      leadForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(function () { document.getElementById('lead-name').focus({ preventScroll: true }); }, 400);
    });

    // E-mail ou WhatsApp : un seul champ obligatoire à la fois
    leadForm.querySelectorAll('input[name="canal"]').forEach(function (r) {
      r.addEventListener('change', function () {
        var wa = leadForm.querySelector('input[name="canal"]:checked').value === 'whatsapp';
        leadForm.querySelector('[data-canal="email"]').hidden = wa;
        leadForm.querySelector('[data-canal="whatsapp"]').hidden = !wa;
        document.getElementById('lead-email').required = !wa;
        document.getElementById('lead-wa').required = wa;
      });
    });

    function showResult() {
      var r = answers.result;
      box.querySelectorAll('[data-result]').forEach(function (el) { el.hidden = el.getAttribute('data-result') !== r; });
      box.querySelector('[data-note]').hidden = false;
      var cat = box.querySelector('[data-cat]');
      if (cat) cat.textContent = cats[answers.profil] || '';
      box.querySelectorAll('[data-fiche]').forEach(function (a) {
        var url = new URL(a.getAttribute('href'), location.href);
        url.searchParams.set('statut', statut[answers.profil]);
        a.setAttribute('href', url.pathname + url.search);
      });
    }

    // 2. Envoi des coordonnées (Formspree), puis affichage du résultat indicatif
    leadForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var err = document.getElementById('lead-error');
      err.hidden = true;
      var fields = leadForm.querySelectorAll('input');
      for (var i = 0; i < fields.length; i++) {
        if (!fields[i].closest('[hidden]') && !fields[i].checkValidity()) { fields[i].reportValidity(); return; }
      }
      var btn = leadForm.querySelector('button[type="submit"]');
      btn.disabled = true; btn.textContent = btn.dataset.sending;
      var canal = leadForm.querySelector('input[name="canal"]:checked').value;
      var data = {
        _subject: "Test d'éligibilité DTV : " + document.getElementById('lead-name').value + ' (' + answers.result + ')',
        source: "Test d'éligibilité (accueil)",
        langue: lang,
        prenom: document.getElementById('lead-name').value,
        canal: canal,
        email: canal === 'email' ? document.getElementById('lead-email').value : '',
        whatsapp: canal === 'whatsapp' ? document.getElementById('lead-wa').value : '',
        profil: answers.profil,
        epargne_500k_thb: answers.epargne,
        lieu_de_demande: answers.lieu,
        resultat_indicatif: answers.result,
        rgpd: 'accepté',
      };
      fetch(FORMSPREE, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(data) })
        .then(function (res) { if (!res.ok) throw new Error('HTTP ' + res.status); })
        .then(function () {
          track('Test éligibilité : coordonnées envoyées', { canal: canal, resultat: answers.result });
          leadForm.hidden = true;
          thanks.hidden = false;
          showResult();
          thanks.focus({ preventScroll: true });
          thanks.scrollIntoView({ behavior: 'smooth', block: 'start' });
        })
        .catch(function () {
          err.hidden = false;
          btn.disabled = false; btn.textContent = btn.dataset.label;
        });
    });
  })();
</script>
