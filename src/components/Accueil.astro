    finalText: 'Machen Sie den Test oder stellen Sie Alexandre Ihre Frage direkt per WhatsApp.',
    finalCta1: 'Test machen',
    finalCta2: 'Per WhatsApp schreiben',
    wa: 'Hallo, ich habe eine Frage zum DTV-Visum.',
  },
}[lang];

// Correspondance entre le profil du test et le champ « statut » de la fiche de renseignement
const STATUT = { remote: 'teletravailleur', freelance: 'independant', softpower: 'activite-encadree', family: 'autre', other: 'autre' };

// Textes de la carte « dossier » (illustration du haut de page) et du bandeau de confiance
const card = {
  fr: { title: 'Vérification de votre dossier', status: 'Rapport sous 48 h', fee: 'Rapport écrit sous 48 h ouvrées', steps: [['Documents envoyés', 'done'], ['Contrôle pièce par pièce', 'done'], ['Rapport écrit de l’expert', 'now'], ['Vous déposez en toute sérénité', 'todo']], trustbar: ['Paiement sécurisé par Stripe', 'Dépôt sur le portail officiel e-Visa', 'Réponse en français ou en anglais'] },
  en: { title: 'Your document check', status: 'Report in 48 h', fee: 'Written report within 48 business hours', steps: [['Documents sent', 'done'], ['Checked one by one', 'done'], ['Expert written report', 'now'], ['You file with confidence', 'todo']], trustbar: ['Secure payment by Stripe', 'Filed on the official e-Visa portal', 'Answers in English or French'] },
  de: { title: 'Prüfung Ihrer Unterlagen', status: 'Bericht in 48 Std.', fee: 'Schriftlicher Bericht in 48 Werktagsstunden', steps: [['Unterlagen gesendet', 'done'], ['Dokument für Dokument geprüft', 'done'], ['Schriftlicher Expertenbericht', 'now'], ['Sie reichen sicher ein', 'todo']], trustbar: ['Sichere Zahlung über Stripe', 'Einreichung über das offizielle e-Visa-Portal', 'Antworten auf Englisch oder Französisch'] },
}[lang];

// Étape « coordonnées » du test : le résultat est envoyé par Alexandre (e-mail ou WhatsApp)
const FORMSPREE = 'https://formspree.io/f/mgaegdgv';
const lead = {
  fr: { title: 'Où vous envoyer votre résultat ?', text: "Alexandre analyse vos réponses et vous envoie votre résultat personnalisé sous 48 h ouvrées.", name: 'Prénom', via: 'Recevoir le résultat par', email: 'E-mail', whatsapp: 'WhatsApp', emailPh: 'vous@exemple.com', waPh: '+33 6 12 34 56 78', consent: "J'accepte que MyVisaDTV utilise ces informations pour m'envoyer mon résultat et me recontacter.", privacy: 'Politique de confidentialité', submit: 'Recevoir mon résultat', sending: 'Envoi…', thanks: 'Merci ! Votre demande est bien reçue.', thanksText: "Alexandre vous envoie votre résultat personnalisé sous 48 h ouvrées. En attendant, voici une première indication :", error: "L'envoi n'a pas fonctionné. Réessayez ou écrivez-nous directement sur WhatsApp." },
  en: { title: 'Where should we send your result?', text: 'Alexandre reviews your answers and sends you your personal result within 48 business hours.', name: 'First name', via: 'Get my result by', email: 'Email', whatsapp: 'WhatsApp', emailPh: 'you@example.com', waPh: '+44 7700 900123', consent: 'I agree that MyVisaDTV may use this information to send me my result and contact me.', privacy: 'Privacy policy', submit: 'Get my result', sending: 'Sending…', thanks: 'Thank you! We have your request.', thanksText: 'Alexandre will send you your personal result within 48 business hours. In the meantime, here is a first indication:', error: "Sending didn't work. Please try again or message us directly on WhatsApp." },
  de: { title: 'Wohin sollen wir Ihr Ergebnis schicken?', text: 'Alexandre prüft Ihre Antworten und schickt Ihnen Ihr persönliches Ergebnis innerhalb von 48 Werktagsstunden.', name: 'Vorname', via: 'Ergebnis erhalten per', email: 'E-Mail', whatsapp: 'WhatsApp', emailPh: 'sie@beispiel.de', waPh: '+49 151 23456789', consent: 'Ich bin einverstanden, dass MyVisaDTV diese Angaben nutzt, um mir mein Ergebnis zu senden und mich zu kontaktieren.', privacy: 'Datenschutzerklärung', submit: 'Ergebnis erhalten', sending: 'Wird gesendet…', thanks: 'Danke! Ihre Anfrage ist eingegangen.', thanksText: 'Alexandre schickt Ihnen Ihr persönliches Ergebnis innerhalb von 48 Werktagsstunden. Hier schon eine erste Einschätzung:', error: 'Das Senden hat nicht funktioniert. Bitte erneut versuchen oder direkt per WhatsApp schreiben.' },
}[lang];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const waLink = `https://wa.me/66631747492?text=${encodeURIComponent(c.wa)}`;
---

<BaseLayout title={c.title} description={c.description} structuredData={structuredData} lang={lang} translated>
  <div class="home-modern">
  <!-- 1. Hero : promesse + carte « dossier » façon application -->
  <section class="bg-white" data-no-reveal>
    <div class="mx-auto grid max-w-content items-center gap-14 px-6 pb-20 pt-14 md:grid-cols-[1.1fr_0.9fr] md:px-10 md:pb-28 md:pt-20">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3 py-1 font-sans text-xs font-medium text-slate-600">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>{c.eyebrow}
        </p>
        <h1 class="mt-6 font-display text-[2.6rem] font-semibold leading-[1.05] tracking-tight text-indigo md:text-6xl">{c.h1}</h1>
        <p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-slate-600">{c.sub}</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row md:flex-col lg:flex-row">
          <a href="#eligibilite" class="hm-btn hm-btn-primary" data-track="Accueil : bouton test (haut)">{c.cta1}</a>
          <a href="#reserver-appel" class="hm-btn hm-btn-ghost" data-track="Accueil : bouton appel (haut)">{c.cta2}</a>
        </div>
        <ul class="mt-10 grid gap-3 lg:grid-cols-3" role="list">
          {c.chips.map((chip) => (
            <li class="flex items-start gap-2 font-sans text-sm text-slate-600">
              <svg viewBox="0 0 20 20" class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5L8 14.5L16 5.5" /></svg>
              {chip}
            </li>
          ))}
        </ul>
      </div>

      <!-- Carte produit : suivi d'un dossier (illustration, pas un vrai dossier) -->
      <div class="relative" aria-hidden="true">
        <div class="absolute -inset-6 -z-0 rounded-[2.5rem] bg-gradient-to-br from-amber-50 via-white to-slate-100"></div>
        <div class="relative rounded-3xl border border-slate-200 bg-white p-6 shadow-[0_30px_60px_-30px_rgba(22,35,63,0.35)] md:p-8">
          <div class="flex items-center justify-between">
            <p class="font-sans text-sm font-semibold text-indigo">{card.title}</p>
            <span class="rounded-full bg-emerald-50 px-2.5 py-1 font-sans text-xs font-medium text-emerald-700">{card.status}</span>
          </div>
          <ol class="mt-6 space-y-4">
            {card.steps.map(([label, state]) => (
              <li class="flex items-center gap-3">
                {state === 'done' ? (
                  <span class="flex h-7 w-7 items-center justify-center rounded-full bg-indigo text-white"><svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10.5L8 14.5L16 5.5" /></svg></span>
                ) : state === 'now' ? (
                  <span class="flex h-7 w-7 items-center justify-center rounded-full border-2 border-or bg-amber-50"><span class="h-2 w-2 rounded-full bg-or"></span></span>
                ) : (
                  <span class="h-7 w-7 rounded-full border-2 border-slate-200"></span>
                )}
                <span class={`font-sans text-sm ${state === 'todo' ? 'text-slate-400' : 'font-medium text-indigo'}`}>{label}</span>
              </li>
            ))}
          </ol>
          <div class="mt-7 flex items-end justify-between rounded-2xl bg-slate-50 px-5 py-4">
            <div>
              <p class="font-sans text-xs text-slate-500">{c.check.name}</p>
              <p class="font-display text-3xl font-semibold tracking-tight text-indigo">{c.check.price}</p>
            </div>
            <p class="max-w-[11rem] text-right font-sans text-xs leading-snug text-slate-500">{card.fee}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bandeau de confiance -->
  <section class="border-y border-slate-200 bg-slate-50">
    <ul class="mx-auto grid max-w-content gap-4 px-6 py-6 font-sans text-sm text-slate-600 sm:grid-cols-3 md:px-10" role="list">
      {card.trustbar.map((t) => (
        <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-or" aria-hidden="true"></span>{t}</li>
      ))}
    </ul>
  </section>

  <!-- 2. Test d'éligibilité -->
  <section class="bg-white scroll-mt-24" id="eligibilite">
    <div class="mx-auto max-w-3xl px-6 py-20 md:px-10 md:py-28">
      <p class="hm-kicker">{c.quizEyebrow}</p>
      <h2 class="hm-h2">{c.quizTitle}</h2>
      <p class="mt-3 font-sans text-base text-slate-600">{c.quizIntro}</p>

      <form id="quiz" data-no-reveal class="mt-10 space-y-9 rounded-3xl border border-slate-200 bg-white p-6 shadow-[0_20px_50px_-30px_rgba(22,35,63,0.25)] md:p-10" novalidate>
        {[
          ['profil', c.q1, c.q1o],
          ['epargne', c.q2, c.q2o],
          ['lieu', c.q3, c.q3o],
        ].map(([name, question, options], qi) => (
          <fieldset>
            <legend class="flex items-start gap-3 font-display text-lg font-semibold text-indigo">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-indigo font-sans text-xs text-white">{qi + 1}</span>
              <span>{question}</span>
            </legend>
            <div class="mt-4 grid gap-2 sm:pl-9">
              {(options as string[][]).map(([value, label]) => (
                <label class="quiz-option flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 px-4 py-3 font-sans text-sm text-slate-700">
                  <input type="radio" name={name as string} value={value} class="mt-0.5 h-4 w-4 shrink-0 accent-indigo" />
                  <span>{label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
        <p id="quiz-missing" class="hidden font-sans text-sm text-red-700" role="alert">{c.missing}</p>
        <button type="submit" class="hm-btn hm-btn-primary w-full sm:w-auto">{c.submit}</button>
      </form>

      <form id="quiz-lead" hidden data-no-reveal class="mt-6 space-y-5 rounded-3xl border-2 border-indigo bg-white p-6 md:p-10" novalidate>
        <div>
          <h3 class="font-display text-2xl font-semibold text-indigo">{lead.title}</h3>
          <p class="mt-2 font-sans text-sm text-slate-600">{lead.text}</p>
        </div>
        <div>
          <label for="lead-name" class="font-sans text-sm font-medium text-indigo">{lead.name}</label>
          <input id="lead-name" name="prenom" type="text" required autocomplete="given-name" class="mt-1 w-full rounded-xl border border-slate-300 px-4 py-3 font-sans text-sm" />
        </div>
        <fieldset>
          <legend class="font-sans text-sm font-medium text-indigo">{lead.via}</legend>
          <div class="mt-2 flex gap-2">
            <label class="quiz-option flex flex-1 cursor-pointer items-center gap-2 rounded-xl border border-slate-200 px-4 py-3 font-sans text-sm"><input type="radio" name="canal" value="email" checked class="accent-indigo" />{lead.email}</label>
            <label class="quiz-option flex flex-1 cursor-pointer items-center gap-2 rounded-xl border border-slate-200 px-4 py-3 font-sans text-sm"><input type="radio" name="canal" value="whatsapp" class="accent-indigo" />{lead.whatsapp}</label>
          </div>
        </fieldset>
        <div data-canal="email">
          <label for="lead-email" class="sr-only">{lead.email}</label>
          <input id="lead-email" name="email" type="email" required autocomplete="email" placeholder={lead.emailPh} class="w-full rounded-xl border border-slate-300 px-4 py-3 font-sans text-sm" />
        </div>
        <div data-canal="whatsapp" hidden>
          <label for="lead-wa" class="sr-only">{lead.whatsapp}</label>
          <input id="lead-wa" name="whatsapp" type="tel" autocomplete="tel" placeholder={lead.waPh} pattern="[+0-9 ().-]{8,}" class="w-full rounded-xl border border-slate-300 px-4 py-3 font-sans text-sm" />
        </div>
        <div class="flex items-start gap-3">
          <input type="checkbox" id="lead-rgpd" name="rgpd" required class="mt-1 h-4 w-4 accent-indigo" />
          <label for="lead-rgpd" class="font-sans text-xs leading-relaxed text-slate-600">{lead.consent} <a href={L('/confidentialite/')} class="underline">{lead.privacy}</a></label>
        </div>
        <p id="lead-error" hidden class="font-sans text-sm text-red-700" role="alert">{lead.error}</p>
        <button type="submit" class="hm-btn hm-btn-primary w-full sm:w-auto" data-label={lead.submit} data-sending={lead.sending}>{lead.submit}</button>
      </form>

      <div id="quiz-thanks" hidden class="mt-6 rounded-3xl bg-emerald-50 p-6 md:p-8" tabindex="-1">
        <h3 class="font-display text-xl font-semibold text-emerald-800">{lead.thanks}</h3>
        <p class="mt-2 font-sans text-sm text-emerald-900/80">{lead.thanksText}</p>
      </div>

      <div id="quiz-result" class="mt-6" aria-live="polite" tabindex="-1">
        <div data-result="ok" hidden class="rounded-3xl bg-indigo p-8 text-white">
          <h3 class="font-display text-2xl font-semibold">{c.res.ok[0]}</h3>
          <p class="mt-3 font-sans text-sm text-white/80">{c.res.ok[1]} <strong class="text-or-light" data-cat></strong></p>
          <p class="mt-2 font-sans text-sm text-white/80">{c.res.ok[2]}</p>
          <a href={L('/fiche-renseignement/')} data-fiche class="hm-btn hm-btn-gold mt-6">{c.res.ok[3]}</a>
        </div>
        {(['savings', 'inside', 'unsure'] as const).map((k) => (
          <div data-result={k} hidden class="rounded-3xl border border-slate-200 bg-slate-50 p-8">
            <h3 class="font-display text-2xl font-semibold text-indigo">{c.res[k][0]}</h3>
            <p class="mt-3 font-sans text-sm leading-relaxed text-slate-600">{c.res[k][1]}</p>
            {k === 'unsure' ? (
              <a href={L('/fiche-renseignement/')} data-fiche class="hm-btn hm-btn-primary mt-6">{c.res[k][2]}</a>
            ) : (
              <a href="#reserver-appel" class="hm-btn hm-btn-primary mt-6">{c.res[k][2]}</a>
            )}
          </div>
        ))}
        <p data-note hidden class="mt-4 font-sans text-xs leading-relaxed text-slate-500">{c.quizNote}</p>
      </div>
    </div>
  </section>

  <!-- 3. Comment ça marche -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-content px-6 py-20 md:px-10 md:py-28">
      <p class="hm-kicker">{c.howEyebrow}</p>
      <h2 class="hm-h2 max-w-2xl">{c.howTitle}</h2>
      <ol class="mt-12 grid gap-4 md:grid-cols-4">
        {c.how.map(([tag, title, text], i) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-6">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo font-sans text-sm font-semibold text-white">{i + 1}</span>
            <p class="mt-5 font-sans text-xs font-semibold uppercase tracking-wide text-or-dark">{tag}</p>
            <h3 class="mt-1 font-display text-lg font-semibold text-indigo">{title}</h3>
            <p class="mt-2 font-sans text-sm leading-relaxed text-slate-600">{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. Les deux formules : la vérification à 99 € (porte d'entrée) est mise en avant -->
  <section class="bg-white scroll-mt-24" id="formules">
    <div class="mx-auto max-w-content px-6 py-20 md:px-10 md:py-28">
      <p class="hm-kicker">{c.offersEyebrow}</p>
      <h2 class="hm-h2 max-w-2xl">{c.offersTitle}</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2 md:items-center">
        <div class="relative flex flex-col rounded-3xl bg-indigo p-8 text-white shadow-[0_30px_60px_-30px_rgba(22,35,63,0.6)] ring-4 ring-or/40 md:p-10">
          <span class="absolute right-6 top-6 rounded-full bg-or px-3 py-1 font-sans text-xs font-semibold text-indigo">{c.check.badge}</span>
          <p class="font-sans text-sm text-white/70">{c.check.tag}</p>
          <h3 class="mt-1 font-display text-2xl font-semibold text-white">{c.check.name}</h3>
          <p class="mt-6 font-display text-6xl font-semibold tracking-tight text-white">{c.check.price}</p>
          <ul class="mt-8 flex-1 space-y-3">
            {c.check.items.map((it) => (
              <li class="flex items-start gap-3 font-sans text-sm text-white/90"><svg viewBox="0 0 20 20" class="mt-0.5 h-4 w-4 shrink-0 text-or-light" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5L8 14.5L16 5.5" /></svg>{it}</li>
            ))}
          </ul>
          <p class="mt-8 font-sans text-sm text-white/60">{c.check.excl}</p>
          <a href={L('/visa-dtv/verification-dossier/')} class="hm-btn hm-btn-gold mt-6 w-full">{c.check.cta}</a>
        </div>
        <div class="relative flex flex-col rounded-3xl border-2 border-slate-300 bg-slate-50 p-8 md:p-10">
          <span class="absolute right-6 top-6 rounded-full border border-slate-300 bg-white px-3 py-1 font-sans text-xs font-semibold text-indigo">{c.full.badge}</span>
          <p class="font-sans text-sm text-slate-500">{c.full.tag}</p>
          <h3 class="mt-1 font-display text-2xl font-semibold text-indigo">{c.full.name}</h3>
          <p class="mt-6 font-display text-5xl font-semibold tracking-tight text-indigo">{c.full.price}</p>
          <p class="mt-2 font-sans text-sm font-medium text-jade">{c.full.value}</p>
          <ul class="mt-8 flex-1 space-y-3">
            {c.full.items.map((it) => (
              <li class="flex items-start gap-3 font-sans text-sm text-slate-700"><svg viewBox="0 0 20 20" class="mt-0.5 h-4 w-4 shrink-0 text-indigo" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5L8 14.5L16 5.5" /></svg>{it}</li>
            ))}
          </ul>
          <p class="mt-8 font-sans text-sm text-slate-500">{c.full.excl}</p>
          <a href={L('/visa-dtv/demande-accompagnee/')} class="hm-btn hm-btn-primary mt-6 w-full">{c.full.cta}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Confiance -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-content px-6 py-20 md:px-10 md:py-28">
      <p class="hm-kicker">{c.trustEyebrow}</p>
      <h2 class="hm-h2 max-w-2xl">{c.trustTitle}</h2>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {c.trust.map(([title, text]) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <h3 class="font-display text-lg font-semibold text-indigo">{title}</h3>
            <p class="mt-2 font-sans text-sm leading-relaxed text-slate-600">{text}</p>
          </div>
        ))}
      </div>
      <a href={L('/a-propos/')} class="mt-8 inline-flex items-center gap-2 font-sans text-sm font-semibold text-indigo hover:text-or-dark">{c.about} <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 6. Appel découverte (#reserver-appel) -->
  <div class="bg-white"><CalInline lang={lang} /></div>

  <!-- 7. FAQ -->
  <section class="bg-white">
    <div class="mx-auto grid max-w-content gap-10 px-6 pb-20 md:grid-cols-[0.8fr_1.2fr] md:px-10 md:pb-28">
      <div>
        <p class="hm-kicker">{c.faqEyebrow}</p>
        <h2 class="hm-h2">{c.faqTitle}</h2>
      </div>
      <div>
        {c.faqs.map(([q, a]) => <FaqItem question={q}>{a}</FaqItem>)}
      </div>
    </div>
  </section>

  <!-- 8. Dernier appel à l'action -->
  <section class="bg-white px-6 pb-20 md:px-10 md:pb-28">
    <div class="mx-auto max-w-content rounded-[2rem] bg-indigo px-8 py-16 text-center md:py-20">
      <h2 class="mx-auto max-w-2xl font-display text-3xl font-semibold tracking-tight text-white md:text-4xl">{c.finalTitle}</h2>
      <p class="mx-auto mt-4 max-w-md font-sans text-base text-white/75">{c.finalText}</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="#eligibilite" class="hm-btn hm-btn-gold" data-track="Accueil : bouton test (bas)">{c.finalCta1}</a>
        <a href={waLink} target="_blank" rel="noopener noreferrer" class="hm-btn hm-btn-outline-light">{c.finalCta2}</a>
      </div>
      <p class="mx-auto mt-8 max-w-xl font-sans text-xs leading-relaxed text-white/60">{c.legal}</p>
    </div>
  </section>
  </div>
</BaseLayout>

<style>
  .home-modern :global(h1),
  .home-modern :global(h2),
  .home-modern :global(h3) {
    font-weight: 600;
  }
  .hm-kicker {
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #a9843a;
  }
  .hm-h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #16233f;
  }
  .hm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0 1.75rem;
    white-space: nowrap;
    border-radius: 9999px;
    font-size: 0.9375rem;
