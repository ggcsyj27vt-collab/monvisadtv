}[lang];

// Correspondance entre le profil du test et le champ « statut » de la fiche de renseignement
const STATUT = { remote: 'teletravailleur', freelance: 'independant', softpower: 'activite-encadree', family: 'autre', other: 'autre' };

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const waLink = `https://wa.me/66631747492?text=${encodeURIComponent(c.wa)}`;
---

<BaseLayout title={c.title} description={c.description} structuredData={structuredData} lang={lang} translated>
  <!-- 1. Hero : promesse, 2 actions, réassurance, visage -->
  <section class="border-b border-sable-light bg-papier" data-no-reveal>
    <div class="mx-auto grid max-w-content gap-12 px-6 py-16 md:grid-cols-[1.15fr_0.85fr] md:items-center md:px-10 md:py-24">
      <div>
        <p class="eyebrow mb-5">{c.eyebrow}</p>
        <h1 class="font-display text-4xl leading-tight text-indigo md:text-5xl">{c.h1}</h1>
        <p class="mt-6 max-w-xl font-sans text-lg leading-relaxed text-encre/80">{c.sub}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#eligibilite" class="btn-primary" data-umami-event="Accueil : bouton test (haut)">{c.cta1}</a>
          <a href="#reserver-appel" class="btn-secondary" data-umami-event="Accueil : bouton appel (haut)">{c.cta2}</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-2" role="list">
          {c.chips.map((chip) => (
            <li class="inline-flex items-center gap-2 rounded-full bg-jade-bg px-3 py-1.5 font-sans text-xs font-medium text-jade">
              <span aria-hidden="true">✓</span>{chip}
            </li>
          ))}
        </ul>
        <p class="mt-6 max-w-xl font-sans text-xs leading-relaxed text-encre/70">{c.legal}</p>
      </div>

      <figure class="mx-auto w-full max-w-sm">
        <img
          src="/images/alexandre-fondateur.jpg"
          alt={c.photoAlt}
          width="922"
          height="1229"
          fetchpriority="high"
          class="aspect-[4/5] w-full rounded-lg object-cover object-[center_30%] shadow-sm"
        />
        <figcaption class="-mt-10 mx-4 relative rounded-md border border-sable-light bg-white px-5 py-4 shadow-sm">
          <p class="font-display text-base text-indigo">{c.photoName}</p>
          <p class="mt-1 font-sans text-sm leading-snug text-encre/75">{c.photoText}</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. Test d'éligibilité (sans JS : le formulaire reste lisible et mène à la fiche) -->
  <section class="section scroll-mt-24" id="eligibilite">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow mb-3">{c.quizEyebrow}</p>
      <h2 class="font-display text-3xl text-indigo">{c.quizTitle}</h2>
      <p class="mt-3 font-sans text-sm text-encre/75">{c.quizIntro}</p>

      <form id="quiz" class="mt-8 space-y-8 rounded-lg border border-sable-light bg-white p-6 md:p-8" novalidate>
        {[
          ['profil', c.q1, c.q1o],
          ['epargne', c.q2, c.q2o],
          ['lieu', c.q3, c.q3o],
        ].map(([name, question, options], qi) => (
          <fieldset>
            <legend class="font-display text-lg text-indigo">
              <span class="mr-2 font-mono text-sm text-or-dark">{`0${qi + 1}`}</span>{question}
            </legend>
            <div class="mt-4 grid gap-2">
              {(options as string[][]).map(([value, label]) => (
                <label class="quiz-option flex cursor-pointer items-start gap-3 rounded-md border border-sable-light px-4 py-3 font-sans text-sm text-encre/90">
                  <input type="radio" name={name as string} value={value} class="mt-0.5 h-4 w-4 shrink-0 accent-indigo" />
                  <span>{label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
        <p id="quiz-missing" class="hidden font-sans text-sm text-red-700" role="alert">{c.missing}</p>
        <button type="submit" class="btn-primary w-full sm:w-auto">{c.submit}</button>
      </form>

      <div id="quiz-result" class="mt-6" aria-live="polite" tabindex="-1">
        <div data-result="ok" hidden class="rounded-lg border-2 border-or bg-white p-6 md:p-8">
          <h3 class="font-display text-2xl text-indigo">{c.res.ok[0]}</h3>
          <p class="mt-3 font-sans text-sm text-encre/80">{c.res.ok[1]} <strong class="text-indigo" data-cat></strong></p>
          <p class="mt-2 font-sans text-sm text-encre/80">{c.res.ok[2]}</p>
          <a href={L('/fiche-renseignement/')} data-fiche class="btn-primary mt-6 inline-flex">{c.res.ok[3]}</a>
        </div>
        {(['savings', 'inside', 'unsure'] as const).map((k) => (
          <div data-result={k} hidden class="rounded-lg border border-sable-light bg-white p-6 md:p-8">
            <h3 class="font-display text-2xl text-indigo">{c.res[k][0]}</h3>
            <p class="mt-3 font-sans text-sm leading-relaxed text-encre/80">{c.res[k][1]}</p>
            {k === 'unsure' ? (
              <a href={L('/fiche-renseignement/')} data-fiche class="btn-primary mt-6 inline-flex">{c.res[k][2]}</a>
            ) : (
              <a href="#reserver-appel" class="btn-primary mt-6 inline-flex">{c.res[k][2]}</a>
            )}
          </div>
        ))}
        <p data-note hidden class="mt-4 font-sans text-xs leading-relaxed text-encre/70">{c.quizNote}</p>
      </div>
    </div>
  </section>

  <!-- 3. Comment ça marche -->
  <section class="section border-t border-sable-light">
    <p class="eyebrow mb-3">{c.howEyebrow}</p>
    <h2 class="max-w-2xl font-display text-3xl text-indigo">{c.howTitle}</h2>
    <ol class="mt-12 grid gap-8 md:grid-cols-4">
      {c.how.map(([tag, title, text], i) => (
        <li>
          <span class="font-display text-2xl text-or-dark">{`0${i + 1}`}</span>
          <p class="mt-2 font-mono text-xs uppercase tracking-wide text-jade">{tag}</p>
          <h3 class="mt-1 font-display text-lg text-indigo">{title}</h3>
          <p class="mt-2 font-sans text-sm leading-relaxed text-encre/80">{text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 4. Les deux formules -->
  <section class="section scroll-mt-24" id="formules">
    <p class="eyebrow mb-3">{c.offersEyebrow}</p>
    <h2 class="max-w-2xl font-display text-3xl text-indigo">{c.offersTitle}</h2>
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      <div class="flex flex-col rounded-lg border border-sable-light bg-white p-8">
        <p class="font-mono text-xs uppercase tracking-wide text-encre/70">{c.check.tag}</p>
        <h3 class="mt-2 font-display text-2xl text-indigo">{c.check.name}</h3>
        <p class="mt-3 font-display text-4xl text-indigo">{c.check.price}</p>
        <ul class="mt-6 flex-1 space-y-3">
          {c.check.items.map((it) => <CheckItem>{it}</CheckItem>)}
        </ul>
        <p class="mt-6 border-t border-sable-light pt-4 font-sans text-sm text-encre/75">{c.check.excl}</p>
        <a href={L('/visa-dtv/verification-dossier/')} class="btn-secondary mt-6 w-full">{c.check.cta}</a>
      </div>
      <div class="relative order-first flex flex-col rounded-lg border-2 border-or bg-white p-8 md:order-none">
        <span class="absolute -top-3 left-6 rounded-full bg-or px-3 py-1 font-sans text-xs font-semibold text-indigo">{c.full.badge}</span>
        <p class="font-mono text-xs uppercase tracking-wide text-encre/70">{c.full.tag}</p>
        <h3 class="mt-2 font-display text-2xl text-indigo">{c.full.name}</h3>
        <p class="mt-3 font-display text-4xl text-indigo">{c.full.price}</p>
        <p class="mt-1 font-sans text-sm font-medium text-jade">{c.full.value}</p>
        <ul class="mt-6 flex-1 space-y-3">
          {c.full.items.map((it) => <CheckItem variant="gold">{it}</CheckItem>)}
        </ul>
        <p class="mt-6 border-t border-sable-light pt-4 font-sans text-sm text-encre/75">{c.full.excl}</p>
        <a href={L('/visa-dtv/demande-accompagnee/')} class="btn-primary mt-6 w-full">{c.full.cta}</a>
      </div>
    </div>
  </section>

  <!-- 5. Confiance (sans témoignages tant qu'il n'y en a pas de réels) -->
  <section class="section border-t border-sable-light">
    <p class="eyebrow mb-3">{c.trustEyebrow}</p>
    <h2 class="max-w-2xl font-display text-3xl text-indigo">{c.trustTitle}</h2>
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {c.trust.map(([title, text]) => (
        <div>
          <h3 class="font-display text-xl text-indigo">{title}</h3>
          <p class="mt-2 font-sans text-sm leading-relaxed text-encre/80">{text}</p>
        </div>
      ))}
    </div>
    <a href={L('/a-propos/')} class="mt-8 inline-block font-sans text-sm font-semibold text-indigo underline decoration-or underline-offset-4 hover:text-or-dark">{c.about}</a>
  </section>

  <!-- 6. Appel découverte (Cal.com intégré, id #reserver-appel) -->
  <CalInline lang={lang} />

  <!-- 7. FAQ centrée sur les objections -->
  <section class="section">
    <p class="eyebrow mb-3">{c.faqEyebrow}</p>
    <h2 class="mb-8 max-w-xl font-display text-3xl text-indigo">{c.faqTitle}</h2>
    <div class="max-w-2xl">
      {c.faqs.map(([q, a]) => <FaqItem question={q}>{a}</FaqItem>)}
    </div>
  </section>

  <!-- 8. Dernier appel à l'action -->
  <section class="border-t border-sable-light bg-indigo text-papier">
    <div class="section text-center">
      <h2 class="mx-auto max-w-xl font-display text-3xl text-papier">{c.finalTitle}</h2>
      <p class="mx-auto mt-4 max-w-md font-sans text-sm text-papier/80">{c.finalText}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="#eligibilite" class="btn-primary inline-flex" data-umami-event="Accueil : bouton test (bas)">{c.finalCta1}</a>
        <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-on-dark inline-flex">{c.finalCta2}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .quiz-option {
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .quiz-option:hover {
    border-color: #c9a24c;
  }
  .quiz-option:has(input:checked) {
    border-color: #16233f;
    background-color: #f7f3ea;
  }
  .quiz-option:has(input:focus-visible) {
    outline: 2px solid #16233f;
    outline-offset: 2px;
  }
</style>

<script define:vars={{ cats: c.cats, statut: STATUT }}>
  (function () {
    var form = document.getElementById('quiz');
    var box = document.getElementById('quiz-result');
    if (!form || !box) return;
    var started = false;
    form.addEventListener('change', function () {
      if (!started && window.umami) window.umami.track('Test éligibilité : commencé');
      started = true;
      document.getElementById('quiz-missing').classList.add('hidden');
    });
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var get = function (n) { var el = form.querySelector('input[name="' + n + '"]:checked'); return el ? el.value : null; };
      var profil = get('profil'), epargne = get('epargne'), lieu = get('lieu');
      if (!profil || !epargne || !lieu) {
        document.getElementById('quiz-missing').classList.remove('hidden');
        return;
      }
      var result = epargne === 'no' ? 'savings' : lieu === 'inside' ? 'inside' : (profil === 'other' || epargne === 'unsure') ? 'unsure' : 'ok';
      box.querySelectorAll('[data-result]').forEach(function (el) { el.hidden = el.getAttribute('data-result') !== result; });
      box.querySelector('[data-note]').hidden = false;
      var cat = box.querySelector('[data-cat]');
      if (cat) cat.textContent = cats[profil] || '';
      box.querySelectorAll('[data-fiche]').forEach(function (a) {
        var url = new URL(a.getAttribute('href'), location.href);
        url.searchParams.set('statut', statut[profil]);
        a.setAttribute('href', url.pathname + url.search);
      });
      if (window.umami) window.umami.track('Test éligibilité : résultat', { resultat: result, profil: profil });
      box.focus({ preventScroll: true });
      box.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>
