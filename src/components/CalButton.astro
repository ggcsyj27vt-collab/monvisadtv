---
// Bouton flottant de prise de rendez-vous (Cal.com), affiché au-dessus du bouton WhatsApp sur toutes les pages.
import type { Locale } from '../i18n/ui';
interface Props {
  lang?: Locale;
}
const { lang = 'fr' } = Astro.props;
const calLink = 'https://cal.com/myvisadtv/appel-decouverte-dtv';
const label = { fr: 'Réserver un appel de 10 min', en: 'Book a 10-min call', de: '10-Minuten-Gespräch buchen' }[lang];
---

<a
  href={calLink}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  class="group fixed bottom-[4.5rem] right-4 z-40 flex items-center gap-3 rounded-full bg-indigo p-2 text-papier shadow-lg transition hover:pr-5 md:bottom-28 md:right-8 md:py-3 md:pl-3 md:pr-3"
>
  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-or text-indigo">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5" aria-hidden="true">
      <rect x="3.5" y="5" width="17" height="15.5" rx="2.5" stroke="currentColor" stroke-width="1.6" />
      <path d="M3.5 9.5h17M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <path d="M12 12.5v3l2 1.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
  <span class="hidden max-w-0 overflow-hidden whitespace-nowrap font-sans text-sm font-semibold opacity-0 transition-all duration-200 group-hover:max-w-xs group-hover:opacity-100 md:inline-block">
    {label}
  </span>
</a>
